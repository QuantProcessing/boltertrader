# Serves the built frontend and forwards its API calls to the auth edge.
#
# Two rules, and the split between them is the whole design: anything under
# /api belongs to the auth edge and nothing else does. There is no fallthrough
# from one to the other — an /api path the edge does not route must come back as
# the edge's own 404, not as index.html with a 200, because a JSON client that
# receives HTML reports a parse error instead of a missing route.

{
	# No admin endpoint: it is an unauthenticated control plane on :2019 that can
	# rewrite this server's own configuration, and nothing in this stack uses it.
	admin off
	# The stack is plain HTTP on loopback. Without this Caddy would try to obtain
	# a certificate for a hostname it was never given.
	auto_https off
	# Nothing to persist — the config arrives as a read-only mount on every start.
	persist_config off
}

:8080 {
	encode zstd gzip

	handle /api/* {
		# The container name on the compose bridge. Caddy keeps the browser's Host
		# header, so the edge sees the origin the cookie was set for.
		#
		# /api/v1/realtime/ws uses a standard WebSocket upgrade, which Caddy
		# relays bidirectionally without a separate buffering rule.
		reverse_proxy authedge:18091
	}

	handle {
		root * /srv
		# A client-side router owns every path below /. try_files serves the real
		# file when there is one and index.html when there is not, so a reload on
		# /portfolio is a page rather than a 404.
		try_files {path} /index.html
		file_server
	}
}
