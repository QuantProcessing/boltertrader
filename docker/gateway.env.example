# Copy this file to a private operator-owned location before use.
# The referenced files contain secret values and must not be committed.

GATEWAY_IMAGE=boltertrader-gateway:local
GATEWAY_CONFIG_FILE=./docker/gateway.docker.yaml
GATEWAY_PORT=18080

GATEWAY_AUTH_TOKEN_FILE=/absolute/path/to/gateway-auth-token
GATEWAY_POSTGRES_DSN_FILE=/absolute/path/to/gateway-postgres-dsn
POSTGRES_PASSWORD_FILE=/absolute/path/to/postgres-password

POSTGRES_USER=gateway
POSTGRES_DB=gateway
