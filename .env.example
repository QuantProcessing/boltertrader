# Copy to .env and fill in what you need. .env is gitignored and must stay that
# way: every value below is a live credential.
#
# This file is NOT how the local stack is configured. `make up` generates the
# stack's own variables — ports, uid, secret paths — into .env.stack, and
# regenerates them on every run. Nothing here is required to bring the stack up
# or to run `make test`. No Make target reads this file at all.
#
# Read by internal/testenv.LoadRepoEnv, which loads it into the test process's
# environment. A variable already set in your shell always wins.
#
# There is no demo or testnet tier any more. The venues implemented those too
# differently to keep working, so the suites that used them were deleted along
# with their credentials. What is left reaches production. To click through the
# product without a venue at all, run `npm --prefix web run dev:mock`.

# -----------------------------------------------------------------------------
# Write gates.
#
# Every test below is read-only until one of these is set to 1. With a gate on,
# that test places a real order on the real exchange with real money. There is
# no sandbox behind it any more. Leave them unset unless you mean it, and turn
# them back off afterwards.
#
# These are the one class of variable this file does not deliver: internal/testenv
# refuses to import any key beginning ENABLE_/ALLOW_/RUN_, or containing _ENABLE_
# or _ALLOW_, from .env — precisely so that a gate cannot be left switched on in
# a file and forgotten. Pass them on the command line instead, where they are
# visible in the command that used them:
#
#   BINANCE_ENABLE_LIVE_WRITE_TESTS=1 go test ./sdk/binance/spot/ -run TestClient_PlaceOrder
#
# The full set, for reference — they are listed, not assigned:
#   BINANCE_ENABLE_LIVE_WRITE_TESTS      BINANCE_PERP_ENABLE_LIVE_WRITE_TESTS
#   OKX_ENABLE_LIVE_WRITE_TESTS          BYBIT_ENABLE_LIVE_WRITE_TESTS
#   BITGET_ENABLE_LIVE_WRITE_TESTS       HYPERLIQUID_ENABLE_LIVE_WRITE_TESTS
#   LIGHTER_ENABLE_LIVE_WRITE_TESTS      BOLTER_ENABLE_NADO_UNSAFE_RAW_SDK_WRITES
#   BOLTER_ENABLE_LIVE_READ_TESTS        RUN_FULL        RUN_SOAK
#
# BOLTER_ENABLE_LIVE_READ_TESTS arms reads, not writes: it lets a test call a
# venue's endpoints without placing anything. No Make target sets it either.

# -----------------------------------------------------------------------------
# Venue credentials.
#
# Each block is all-or-nothing: a read test skips, naming the variable it wanted,
# unless every variable in its block is set. A write test with its gate on fails
# instead of skipping — you asked for the write explicitly, so a silent skip
# would read as a passing write test.
#
# Keys need only the permissions the tests use. Withhold withdrawal permission
# and bind the key to your own IP wherever the venue offers it.
# -----------------------------------------------------------------------------

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# BITGET_SECRET_KEY, not _API_SECRET — Bitget's own naming, kept as-is.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# The wallet-signed venues. These are private keys, not API keys: anything they
# sign for is spendable, and there is no testnet wallet to hold instead. Fund
# the account with only what you are prepared to have an order consume.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDR=

LIGHTER_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_KEY_INDEX=

NADO_PRIVATE_KEY=
# NADO_SUBACCOUNT_NAME=

EDGEX_STARK_PRIVATE_KEY=
EDGEX_ACCOUNT_ID=

GRVT_PRIVATE_KEY=
GRVT_API_KEY=
GRVT_SUB_ACCOUNT_ID=

STANDX_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Selectors, all optional.
#
# Several write tests act on an order you already have, or on a size you choose,
# rather than on a default: BINANCE_SPOT_TEST_ORDER_ID, OKX_TEST_ORDER_PRICE,
# BINANCE_PERP_TEST_ORDER_QTY and their siblings. They are not listed here
# because each belongs to one test. Run the test with its gate on and it will
# fail naming exactly the variables it wanted.
