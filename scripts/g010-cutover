#!/bin/sh
set -eu

fail() { printf 'g010-cutover: %s\n' "$*" >&2; exit 1; }

[ "${FT_MODE:-}" = test ] || fail "FT_MODE must be exactly test"
[ "${BT_G010_CUTOVER_ACCEPT:-}" = 1 ] || fail "set BT_G010_CUTOVER_ACCEPT=1 to authorize the Test cutover"

case "${BT_DEV_ENABLE_LIVE_PRIVATE_WRITES:-0}" in 0) ;; *) fail "BT_DEV_ENABLE_LIVE_PRIVATE_WRITES must be unset or 0" ;; esac
case "${BT_LIVE_PRIVATE_WRITES_ENABLED:-0}" in 0) ;; *) fail "BT_LIVE_PRIVATE_WRITES_ENABLED must be unset or 0" ;; esac
[ "${RUN_FULL+x}" != x ] || fail "RUN_FULL must be unset"
[ "${BT_FUNDING_LIVE_ENABLED+x}" != x ] || fail "BT_FUNDING_LIVE_ENABLED must be unset"
for legacy in BT_G010_ACTIVATION_AT BT_G010_CUTOVER_AT BT_G010_ACTIVATION_PROOF; do
	eval "configured=\${$legacy+x}"
	[ "$configured" != x ] || fail "$legacy is not accepted; activation evidence is generated by migration-tool activate"
done

for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
	case "$name" in
		BOLTER_ENABLE_*_WRITES|BOLTER_ALLOW_*_WRITES|*LIVE*WRITE*|*WRITES_ENABLED)
			eval "value=\${$name-}"
			case "$name:$value" in
				BT_DEV_ENABLE_LIVE_PRIVATE_WRITES:0|BT_LIVE_PRIVATE_WRITES_ENABLED:0) ;;
				*) fail "$name is a forbidden venue-write opt-in" ;;
			esac
			;;
	esac
done

RUNTIME_DIR=${FT_LOCAL_RUNTIME_DIR:-/tmp/boltertrader-local}
case "$RUNTIME_DIR" in /*) ;; *) fail "FT_LOCAL_RUNTIME_DIR must be absolute" ;; esac
case "$RUNTIME_DIR" in *'/../'*|*'/..'|*'/./'*|*'/.' ) fail "FT_LOCAL_RUNTIME_DIR must be canonical" ;; esac

STATE_DIR=${BT_G010_STATE_DIR:-$RUNTIME_DIR/state/test}
EVIDENCE_DIR=${BT_G010_EVIDENCE_DIR:-$RUNTIME_DIR/migration/test/evidence}
BACKUP_ARTIFACT=${BT_G010_BACKUP_ARTIFACT:-$RUNTIME_DIR/migration/test/backup.dump}
DELTA_ARTIFACT=${BT_G010_FINAL_DELTA_ARTIFACT:-$RUNTIME_DIR/migration/test/final-delta.dump}
[ "$STATE_DIR" = "$RUNTIME_DIR/state/test" ] || fail "BT_G010_STATE_DIR must be the mode-scoped path $RUNTIME_DIR/state/test"
[ "$EVIDENCE_DIR" = "$RUNTIME_DIR/migration/test/evidence" ] || fail "BT_G010_EVIDENCE_DIR must be the mode-scoped path $RUNTIME_DIR/migration/test/evidence"
[ "$BACKUP_ARTIFACT" = "$RUNTIME_DIR/migration/test/backup.dump" ] || fail "BT_G010_BACKUP_ARTIFACT must be mode-scoped"
[ "$DELTA_ARTIFACT" = "$RUNTIME_DIR/migration/test/final-delta.dump" ] || fail "BT_G010_FINAL_DELTA_ARTIFACT must be mode-scoped"

MANIFEST=${BT_G010_MANIFEST_PATH:-migration/manifest.json}
DEV_PLATFORM=${BT_G010_DEV_PLATFORM:-./scripts/dev-platform}
PSQL=${BT_G010_PSQL:-psql}
MAKE=${BT_G010_MAKE:-make}
NPM=${BT_G010_NPM:-npm}
MIGRATION_TOOL=${BT_G010_MIGRATION_TOOL:-}

for executable in "$DEV_PLATFORM" "$PSQL" "$MAKE" "$NPM" ${MIGRATION_TOOL:+"$MIGRATION_TOOL"}; do
	case "$executable" in *[[:space:]]*) fail "configured executables must be single paths" ;; esac
done

reject_private_route() {
	case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
		*'/orders'*|*'/order'*|*'/positions'*|*'/position'*|*'/leverage'*|*'/withdraw'*|*'/transfer'*)
			fail "private venue write route is forbidden in G010 command configuration"
			;;
	esac
}
reject_private_route "$DEV_PLATFORM"
reject_private_route "$PSQL"
reject_private_route "$MAKE"
reject_private_route "$NPM"
reject_private_route "$MIGRATION_TOOL"
for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
	eval "value=\${$name-}"
	reject_private_route "$value"
done

GATEWAY_URL=${BT_GATEWAY_URL:-http://127.0.0.1:18082}
PLATFORM_BROWSER_URL=${BT_PLATFORM_BROWSER_URL:-http://127.0.0.1:18091/api/v1}
PLATFORM_WORK_URL=${BT_PLATFORM_WORK_URL:-http://127.0.0.1:18092}
WEB_URL=${BT_WEB_URL:-http://127.0.0.1:13001}
[ "$GATEWAY_URL" = http://127.0.0.1:18082 ] || fail "BT_GATEWAY_URL must use the canonical loopback service URL"
[ "$PLATFORM_BROWSER_URL" = http://127.0.0.1:18091/api/v1 ] || fail "BT_PLATFORM_BROWSER_URL must use the canonical loopback service URL"
[ "$PLATFORM_WORK_URL" = http://127.0.0.1:18092 ] || fail "BT_PLATFORM_WORK_URL must use the canonical loopback service URL"
[ "$WEB_URL" = http://127.0.0.1:13001 ] || fail "BT_WEB_URL must use the canonical loopback service URL"

SOURCE_SERVICE=${BT_G010_SOURCE_SERVICE:-funding_source_test}
TARGET_SERVICE=${BT_G010_TARGET_SERVICE:-platform_target_test}
GATEWAY_SERVICE=${BT_G010_GATEWAY_SERVICE:-gateway_test}
MAINTENANCE_SERVICE=${BT_G010_MAINTENANCE_SERVICE:-platform_maintenance_test}
SOURCE_DATABASE=${BT_G010_SOURCE_DATABASE:-bolter_funding_test}
TARGET_DATABASE=${BT_G010_TARGET_DATABASE:-${BT_PLATFORM_DATABASE:-bolter_platform_test}}
GATEWAY_DATABASE=${BT_G010_GATEWAY_DATABASE:-bolter_gateway_test}
MAINTENANCE_DATABASE=${BT_G010_MAINTENANCE_DATABASE:-bolter_maintenance_test}
SOURCE_ROLE=${BT_G010_SOURCE_ROLE:-bolter_funding_test_migrator}
TARGET_ROLE=${BT_G010_TARGET_ROLE:-bolter_platform_test_migrator}
GATEWAY_ROLE=${BT_G010_GATEWAY_ROLE:-bolter_gateway_test_migrator}
TARGET_RUNTIME_ROLE=${BT_G010_TARGET_RUNTIME_ROLE:-${BT_PLATFORM_DATABASE_ROLE:-bolter_platform_test}}
GATEWAY_RUNTIME_ROLE=${BT_G010_GATEWAY_RUNTIME_ROLE:-bolter_gateway_test}
MAINTENANCE_ROLE=${BT_G010_MAINTENANCE_ROLE:-bolter_platform_test_admin}
SOURCE_WRITER_ROLE=${BT_G010_SOURCE_WRITER_ROLE:-bolter_funding_test_writer}
TARGET_WRITER_ROLE=${BT_G010_TARGET_WRITER_ROLE:-bolter_platform_test_writer}
GATEWAY_WRITER_ROLE=${BT_G010_GATEWAY_WRITER_ROLE:-bolter_gateway_test_writer}

require_test_identity() {
	[ "$2" = "$3" ] || fail "$1 must be the canonical Test identity $3"
}
require_test_identity BT_G010_SOURCE_SERVICE "$SOURCE_SERVICE" funding_source_test
require_test_identity BT_G010_TARGET_SERVICE "$TARGET_SERVICE" platform_target_test
require_test_identity BT_G010_GATEWAY_SERVICE "$GATEWAY_SERVICE" gateway_test
require_test_identity BT_G010_MAINTENANCE_SERVICE "$MAINTENANCE_SERVICE" platform_maintenance_test
require_test_identity BT_G010_SOURCE_DATABASE "$SOURCE_DATABASE" bolter_funding_test
require_test_identity BT_G010_TARGET_DATABASE "$TARGET_DATABASE" bolter_platform_test
require_test_identity BT_G010_GATEWAY_DATABASE "$GATEWAY_DATABASE" bolter_gateway_test
require_test_identity BT_G010_MAINTENANCE_DATABASE "$MAINTENANCE_DATABASE" bolter_maintenance_test
require_test_identity BT_G010_SOURCE_ROLE "$SOURCE_ROLE" bolter_funding_test_migrator
require_test_identity BT_G010_TARGET_ROLE "$TARGET_ROLE" bolter_platform_test_migrator
require_test_identity BT_G010_GATEWAY_ROLE "$GATEWAY_ROLE" bolter_gateway_test_migrator
require_test_identity BT_G010_TARGET_RUNTIME_ROLE "$TARGET_RUNTIME_ROLE" bolter_platform_test
require_test_identity BT_G010_GATEWAY_RUNTIME_ROLE "$GATEWAY_RUNTIME_ROLE" bolter_gateway_test
require_test_identity BT_G010_MAINTENANCE_ROLE "$MAINTENANCE_ROLE" bolter_platform_test_admin
require_test_identity BT_G010_SOURCE_WRITER_ROLE "$SOURCE_WRITER_ROLE" bolter_funding_test_writer
require_test_identity BT_G010_TARGET_WRITER_ROLE "$TARGET_WRITER_ROLE" bolter_platform_test_writer
require_test_identity BT_G010_GATEWAY_WRITER_ROLE "$GATEWAY_WRITER_ROLE" bolter_gateway_test_writer

SECRET_STORE_DIR=${BT_SECRET_STORE_DIR:-$RUNTIME_DIR/secret-store}
SECRET_STORE_NAMESPACE=${BT_SECRET_STORE_NAMESPACE:-boltertrader/test}
SECRET_MASTER_KEY_FILE=${BT_SECRET_MASTER_KEY_FILE:-$RUNTIME_DIR/credentials/test/secret-store-master.key}
SECRET_KEY_SOURCE=${BT_SECRET_KEY_SOURCE:-file}
SECRET_MASTER_KEY_VERSION=${BT_SECRET_MASTER_KEY_VERSION:-v1}
[ "$SECRET_STORE_DIR" = "$RUNTIME_DIR/secret-store" ] || fail "BT_SECRET_STORE_DIR must be the canonical Test Secret Store path"
[ "$SECRET_STORE_NAMESPACE" = boltertrader/test ] || fail "BT_SECRET_STORE_NAMESPACE must be boltertrader/test"
[ "$SECRET_MASTER_KEY_FILE" = "$RUNTIME_DIR/credentials/test/secret-store-master.key" ] || fail "BT_SECRET_MASTER_KEY_FILE must be mode-scoped"
[ "$SECRET_KEY_SOURCE" = file ] || fail "BT_SECRET_KEY_SOURCE must be file"
[ "$SECRET_MASTER_KEY_VERSION" = v1 ] || fail "BT_SECRET_MASTER_KEY_VERSION must be v1"

file_mode() {
	stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1" 2>/dev/null
}
[ -d "$SECRET_STORE_DIR" ] && [ ! -L "$SECRET_STORE_DIR" ] || fail "Secret Store directory is unavailable or unsafe"
[ "$(file_mode "$SECRET_STORE_DIR")" = 700 ] || fail "Secret Store directory permissions must be 0700"
[ -f "$SECRET_MASTER_KEY_FILE" ] && [ ! -L "$SECRET_MASTER_KEY_FILE" ] || fail "Secret Store master key is unavailable or unsafe"
[ "$(file_mode "$SECRET_MASTER_KEY_FILE")" = 600 ] || fail "Secret Store master key permissions must be 0600"

migration_tool() {
	if [ -n "$MIGRATION_TOOL" ]; then
		"$MIGRATION_TOOL" "$@"
	else
		go run ./cmd/migration-tool "$@"
	fi
}

phase_at_least() {
	want=$1
	case "$phase:$want" in
		backed-up:backed-up|restored:backed-up|delta-captured:backed-up|fenced:backed-up|backfilled:backed-up|validated:backed-up|activation-ready:backed-up|activated:backed-up) return 0 ;;
		restored:restored|delta-captured:restored|fenced:restored|backfilled:restored|validated:restored|activation-ready:restored|activated:restored) return 0 ;;
		delta-captured:delta-captured|fenced:delta-captured|backfilled:delta-captured|validated:delta-captured|activation-ready:delta-captured|activated:delta-captured) return 0 ;;
		fenced:fenced|backfilled:fenced|validated:fenced|activation-ready:fenced|activated:fenced) return 0 ;;
		backfilled:backfilled|validated:backfilled|activation-ready:backfilled|activated:backfilled) return 0 ;;
		validated:validated|activation-ready:validated|activated:validated) return 0 ;;
	esac
	return 1
}

writer_state() {
	service=$1 database=$2 writer_role=$3
	"$PSQL" "service=$service dbname=$database" --no-psqlrc --tuples-only --no-align \
		--set "writer_role=$writer_role" \
		--file - <<'SQL' |
SELECT r.rolcanlogin::text || '|' || count(a.pid)::text FROM pg_roles r LEFT JOIN pg_stat_activity a ON a.usename=r.rolname AND a.pid<>pg_backend_pid() WHERE r.rolname=:'writer_role' GROUP BY r.rolcanlogin;
SQL
		tr -d '[:space:]'
}

recheck_real_stack() {
	BT_DEV_REAL_STACK_ACCEPTANCE=1 FT_MODE=test BT_DEV_ENABLE_LIVE_PRIVATE_WRITES=0 BT_LIVE_PRIVATE_WRITES_ENABLED=0 \
		"$MAKE" test-real || fail "real stack verification failed"
	BT_DEV_REAL_BROWSER_ACCEPTANCE=1 FT_MODE=test BT_DEV_ENABLE_LIVE_PRIVATE_WRITES=0 BT_LIVE_PRIVATE_WRITES_ENABLED=0 \
		"$NPM" --prefix web run test:e2e:real || fail "real browser verification failed"
}

run_backup() {
	migration_tool backup --manifest "$MANIFEST" --evidence-dir "$EVIDENCE_DIR" --id g010-test-backup --artifact "$BACKUP_ARTIFACT" --source-service "$SOURCE_SERVICE" --source-database "$SOURCE_DATABASE" --source-role "$SOURCE_ROLE"
}

run_restore() {
	migration_tool restore --manifest "$MANIFEST" --evidence-dir "$EVIDENCE_DIR" --artifact "$BACKUP_ARTIFACT" --target-service "$TARGET_SERVICE" --target-database "$TARGET_DATABASE" --target-role "$TARGET_ROLE" --maintenance-service "$MAINTENANCE_SERVICE" --maintenance-database "$MAINTENANCE_DATABASE" --maintenance-role "$MAINTENANCE_ROLE" --verifier g010-cutover
}

run_final_delta() {
	migration_tool final-delta --manifest "$MANIFEST" --evidence-dir "$EVIDENCE_DIR" --artifact "$DELTA_ARTIFACT" --source-service "$SOURCE_SERVICE" --source-database "$SOURCE_DATABASE" --source-role "$SOURCE_ROLE" --target-service "$TARGET_SERVICE" --target-database "$TARGET_DATABASE" --target-role "$TARGET_ROLE" --maintenance-service "$MAINTENANCE_SERVICE" --maintenance-database "$MAINTENANCE_DATABASE" --maintenance-role "$MAINTENANCE_ROLE"
}

run_fence() {
	migration_tool fence --manifest "$MANIFEST" --evidence-dir "$EVIDENCE_DIR" --source-service "$SOURCE_SERVICE" --source-database "$SOURCE_DATABASE" --source-role "$SOURCE_ROLE" --source-writer-role "$SOURCE_WRITER_ROLE" --target-service "$TARGET_SERVICE" --target-database "$TARGET_DATABASE" --target-role "$TARGET_ROLE" --target-writer-role "$TARGET_WRITER_ROLE" --maintenance-service "$MAINTENANCE_SERVICE" --maintenance-database "$MAINTENANCE_DATABASE" --maintenance-role "$MAINTENANCE_ROLE"
}

BACKFILL_MAPPING=${BT_G010_BACKFILL_MAPPING:-migration/backfills/account-route-v1.json}
reject_private_route "$BACKFILL_MAPPING"

run_backfill() {
	migration_tool backfill --manifest "$MANIFEST" --evidence-dir "$EVIDENCE_DIR" --backfill-mapping "$BACKFILL_MAPPING" --source-service "$SOURCE_SERVICE" --source-database "$SOURCE_DATABASE" --source-role "$SOURCE_ROLE" --source-writer-role "$SOURCE_WRITER_ROLE" --target-service "$TARGET_SERVICE" --target-database "$TARGET_DATABASE" --target-role "$TARGET_ROLE" --target-writer-role "$TARGET_WRITER_ROLE" --gateway-service "$GATEWAY_SERVICE" --gateway-database "$GATEWAY_DATABASE" --gateway-role "$GATEWAY_ROLE" --maintenance-service "$MAINTENANCE_SERVICE" --maintenance-database "$MAINTENANCE_DATABASE" --maintenance-role "$MAINTENANCE_ROLE"
}

run_validate() {
	migration_tool validate --manifest "$MANIFEST" --evidence-dir "$EVIDENCE_DIR" --verifier g010-cutover
}

run_activate() {
	migration_tool activate --manifest "$MANIFEST" --evidence-dir "$EVIDENCE_DIR" --journal "$EVIDENCE_DIR/activation-attempt.json" --state-dir "$STATE_DIR" --backup-id g010-test-backup --backup-artifact "$BACKUP_ARTIFACT" --final-delta-artifact "$DELTA_ARTIFACT" --backfill-mapping "$BACKFILL_MAPPING" --verifier g010-cutover --source-service "$SOURCE_SERVICE" --source-database "$SOURCE_DATABASE" --source-role "$SOURCE_ROLE" --source-writer-role "$SOURCE_WRITER_ROLE" --target-service "$TARGET_SERVICE" --target-database "$TARGET_DATABASE" --target-role "$TARGET_ROLE" --target-runtime-role "$TARGET_RUNTIME_ROLE" --target-writer-role "$TARGET_WRITER_ROLE" --gateway-service "$GATEWAY_SERVICE" --gateway-database "$GATEWAY_DATABASE" --gateway-role "$GATEWAY_ROLE" --gateway-runtime-role "$GATEWAY_RUNTIME_ROLE" --gateway-writer-role "$GATEWAY_WRITER_ROLE" --maintenance-service "$MAINTENANCE_SERVICE" --maintenance-database "$MAINTENANCE_DATABASE" --maintenance-role "$MAINTENANCE_ROLE"
}

revalidate_completed() {
	if phase_at_least backed-up; then
		run_backup || fail "migration-tool backup failed"
	fi
	if phase_at_least restored; then
		run_restore || fail "migration-tool restore failed"
	fi
	if phase_at_least delta-captured; then
		run_final_delta || fail "migration-tool final-delta failed"
	fi
	if phase_at_least fenced; then
		run_fence || fail "migration-tool fence failed"
		[ "$(writer_state "$SOURCE_SERVICE" "$SOURCE_DATABASE" "$SOURCE_WRITER_ROLE")" = 'false|0' ] || fail "source writer remains active after fence"
		[ "$(writer_state "$TARGET_SERVICE" "$TARGET_DATABASE" "$TARGET_WRITER_ROLE")" = 'false|0' ] || fail "target writer remains active after fence"
	fi
	if phase_at_least backfilled; then
		run_backfill || fail "migration-tool backfill failed"
	fi
	if phase_at_least validated; then
		run_validate || fail "migration-tool validate failed"
	fi
}

verify_structured_evidence() {
	migration_tool verify-evidence --manifest "$MANIFEST" --evidence-dir "$EVIDENCE_DIR" --import-commit "$IMPORT_COMMIT" || fail "migration-tool verify-evidence failed"
}

IMPORT_COMMIT=${BT_G010_IMPORT_COMMIT:-$(git rev-parse HEAD)}
[ "${#IMPORT_COMMIT}" -eq 40 ] || fail "BT_G010_IMPORT_COMMIT must be a 40-character git object id"
case "$IMPORT_COMMIT" in *[!0-9a-f]*) fail "BT_G010_IMPORT_COMMIT must be a lowercase git object id" ;; esac

while :; do
	status=$(migration_tool status --manifest "$MANIFEST") || fail "migration-tool status failed"
	phase=$(printf '%s\n' "$status" | sed -n 's/.*"phase"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
	case "$phase" in
		baseline|provenance-ready|backed-up|restored|delta-captured|fenced|backfilled|validated|activation-ready|activated) ;;
		retirement-ready) fail "G010 must stop before source retirement" ;;
		*) fail "migration-tool status returned an unsupported phase" ;;
	esac
	if [ "$phase" = activated ]; then
		run_activate || fail "migration-tool activate replay failed"
		printf 'g010-cutover: activated; source retirement remains outside G010\n'
		exit 0
	fi
	verify_structured_evidence
	revalidate_completed
	if phase_at_least validated; then
		recheck_real_stack
	fi

	case "$phase" in
		baseline)
			migration_tool record-import --manifest "$MANIFEST" --evidence-dir "$EVIDENCE_DIR" --id "$IMPORT_COMMIT" || fail "migration-tool record-import failed"
			;;
		provenance-ready)
			run_backup || fail "migration-tool backup failed"
			;;
		backed-up)
			run_restore || fail "migration-tool restore failed"
			;;
		restored)
			run_final_delta || fail "migration-tool final-delta failed"
			;;
		delta-captured)
			run_fence || fail "migration-tool fence failed"
			;;
		fenced)
			run_backfill || fail "migration-tool backfill failed"
			;;
		backfilled)
			"$DEV_PLATFORM" doctor >/dev/null || fail "Secret Store or service permission checks failed"
			run_validate || fail "migration-tool validate failed"
			;;
		validated)
			migration_tool prepare-activation --manifest "$MANIFEST" || fail "migration-tool prepare-activation failed"
			;;
		activation-ready)
			run_activate || fail "migration-tool activate failed"
			;;
		activated)
			fail "activated replay dispatch was bypassed"
			;;
	esac
done
