#!/bin/sh
set -eu

fail() { printf 'dev-platform: %s\n' "$*" >&2; exit 1; }

if [ "${FT_MODE:-test}" = "live" ]; then
	live_env=${BT_DEV_LIVE_ENV_FILE:-}
	[ -n "$live_env" ] || fail "FT_MODE=live requires BT_DEV_LIVE_ENV_FILE"
	[ -f "$live_env" ] || fail "live env file does not exist: $live_env"
	# The operator owns this ignored overlay; the launcher never prints its values.
	. "$live_env"
	[ "${FT_MODE:-test}" = "live" ] || fail "live env file must not change FT_MODE"
fi

SERVICES_START="postgres gateway platform funding-worker web"
SERVICES_STOP="web funding-worker platform gateway postgres"
FIXED_PORTS="postgres:15432 gateway:18082 platform-browser:18091 platform-work:18092 web:13001"

RUNTIME_DIR=${FT_LOCAL_RUNTIME_DIR:-/tmp/boltertrader-local}
MODE=${FT_MODE:-test}
BT_MODE=$MODE
WORKER_ID=${BT_FUNDING_WORKER_ID:-funding-default-$MODE}
STATE_DIR="$RUNTIME_DIR/state/$MODE"
PID_DIR="$STATE_DIR/pids"
LOG_DIR="$STATE_DIR/logs"
OWNERSHIP_DIR="$STATE_DIR/ownership"
CREDENTIAL_DIR="$RUNTIME_DIR/credentials/$MODE"
EXPECTED_TOKEN_FILE="$CREDENTIAL_DIR/funding-worker.token"
TOKEN_FILE=${BT_FUNDING_WORKER_TOKEN_FILE:-$EXPECTED_TOKEN_FILE}
EXPECTED_GATEWAY_TOKEN_FILE="$CREDENTIAL_DIR/gateway-adapter.token"
GATEWAY_TOKEN_FILE=${BT_GATEWAY_TOKEN_FILE:-$EXPECTED_GATEWAY_TOKEN_FILE}
EXPECTED_MANUAL_PREVIEW_KEY_FILE="$CREDENTIAL_DIR/manual-preview-signing.key"
MANUAL_PREVIEW_KEY_FILE=${BT_MANUAL_PREVIEW_SIGNING_KEY_FILE:-$EXPECTED_MANUAL_PREVIEW_KEY_FILE}
EXPECTED_SECRET_MASTER_KEY_FILE="$CREDENTIAL_DIR/secret-store-master.key"
SECRET_MASTER_KEY_FILE=${BT_SECRET_MASTER_KEY_FILE:-$EXPECTED_SECRET_MASTER_KEY_FILE}
EXPECTED_SECRET_STORE_DIR="$RUNTIME_DIR/secret-store"
SECRET_STORE_DIR=${BT_SECRET_STORE_DIR:-$EXPECTED_SECRET_STORE_DIR}
SECRET_KEY_SOURCE=${BT_SECRET_KEY_SOURCE:-file}
SECRET_MASTER_KEY_VERSION=${BT_SECRET_MASTER_KEY_VERSION:-v1}
EXPECTED_SECRET_STORE_NAMESPACE=boltertrader/$MODE
SECRET_STORE_NAMESPACE=${BT_SECRET_STORE_NAMESPACE:-$EXPECTED_SECRET_STORE_NAMESPACE}
BT_GATEWAY_URL=${BT_GATEWAY_URL:-http://127.0.0.1:18082}
BT_GATEWAY_TOKEN_FILE=$GATEWAY_TOKEN_FILE
BT_MANUAL_PREVIEW_SIGNING_KEY_FILE=$MANUAL_PREVIEW_KEY_FILE
GATEWAY_AUTH_TOKEN_FILE=$GATEWAY_TOKEN_FILE
export BT_GATEWAY_URL BT_GATEWAY_TOKEN_FILE GATEWAY_AUTH_TOKEN_FILE
export BT_MANUAL_PREVIEW_SIGNING_KEY_FILE
BT_SECRET_MASTER_KEY_FILE=$SECRET_MASTER_KEY_FILE
BT_SECRET_KEY_SOURCE=$SECRET_KEY_SOURCE
BT_SECRET_STORE_DIR=$SECRET_STORE_DIR
BT_SECRET_STORE_NAMESPACE=$SECRET_STORE_NAMESPACE
BT_SECRET_MASTER_KEY_VERSION=$SECRET_MASTER_KEY_VERSION
export BT_SECRET_KEY_SOURCE BT_SECRET_STORE_DIR BT_SECRET_STORE_NAMESPACE
export BT_SECRET_MASTER_KEY_VERSION BT_SECRET_MASTER_KEY_FILE
export BT_MODE
START_TIMEOUT=${BT_DEV_START_TIMEOUT_SECONDS:-30}
STOP_TIMEOUT=${BT_DEV_STOP_TIMEOUT_SECONDS:-15}
DRAIN_TIMEOUT=${BT_DEV_DRAIN_TIMEOUT_SECONDS:-30}

case "$MODE" in
	live)
		BT_PLATFORM_DATABASE=bolter_platform_live
		BT_PLATFORM_DATABASE_ROLE=bolter_platform_live
		case "${BT_DEV_ENABLE_LIVE_PRIVATE_WRITES:-0}" in
			0) BT_LIVE_PRIVATE_WRITES_ENABLED=0 ;;
			1) BT_LIVE_PRIVATE_WRITES_ENABLED=1 ;;
			*) fail "BT_DEV_ENABLE_LIVE_PRIVATE_WRITES must be 0 or 1" ;;
		esac
		export BT_LIVE_PRIVATE_WRITES_ENABLED
		;;
	test)
		BT_PLATFORM_DATABASE=bolter_platform_test
		BT_PLATFORM_DATABASE_ROLE=bolter_platform_test
		BT_LIVE_PRIVATE_WRITES_ENABLED=0
		export BT_LIVE_PRIVATE_WRITES_ENABLED
		;;
esac
export BT_PLATFORM_DATABASE BT_PLATFORM_DATABASE_ROLE

service_key() {
	case "$1" in
		postgres) printf 'POSTGRES' ;;
		gateway) printf 'GATEWAY' ;;
		platform) printf 'PLATFORM' ;;
		funding-worker) printf 'FUNDING_WORKER' ;;
		web) printf 'WEB' ;;
		*) fail "unknown service: $1" ;;
	esac
}

configured_value() {
	key=$(service_key "$1")
	suffix=$2
	eval "printf '%s' \"\${BT_DEV_${key}_${suffix}:-}\""
}

prepare_directories() {
	umask 077
	for dir in "$RUNTIME_DIR" "$STATE_DIR" "$PID_DIR" "$LOG_DIR" "$OWNERSHIP_DIR" "$CREDENTIAL_DIR" "$SECRET_STORE_DIR"; do
		mkdir -p "$dir"
		chmod 700 "$dir"
	done
}

validate_mode() {
	case "$MODE" in
		test) ;;
		live)
			live_env=${BT_DEV_LIVE_ENV_FILE:-}
			[ -n "$live_env" ] || fail "FT_MODE=live requires BT_DEV_LIVE_ENV_FILE"
			[ -f "$live_env" ] || fail "live env file does not exist: $live_env"
			case "${BT_LIVE_PRIVATE_WRITES_ENABLED:-0}" in 0|1) ;; *) fail "BT_LIVE_PRIVATE_WRITES_ENABLED must be 0 or 1" ;; esac
			;;
		*) fail "FT_MODE must be exactly test or live" ;;
	esac
	[ "$TOKEN_FILE" = "$EXPECTED_TOKEN_FILE" ] || fail "BT_FUNDING_WORKER_TOKEN_FILE must be the mode-scoped path $EXPECTED_TOKEN_FILE"
	[ "$GATEWAY_TOKEN_FILE" = "$EXPECTED_GATEWAY_TOKEN_FILE" ] || fail "BT_GATEWAY_TOKEN_FILE must be the mode-scoped path $EXPECTED_GATEWAY_TOKEN_FILE"
	[ "$MANUAL_PREVIEW_KEY_FILE" = "$EXPECTED_MANUAL_PREVIEW_KEY_FILE" ] || fail "BT_MANUAL_PREVIEW_SIGNING_KEY_FILE must be the mode-scoped path $EXPECTED_MANUAL_PREVIEW_KEY_FILE"
	[ "$SECRET_MASTER_KEY_FILE" = "$EXPECTED_SECRET_MASTER_KEY_FILE" ] || fail "BT_SECRET_MASTER_KEY_FILE must be the mode-scoped path $EXPECTED_SECRET_MASTER_KEY_FILE"
	[ "$SECRET_KEY_SOURCE" = file ] || fail "BT_SECRET_KEY_SOURCE must be file for the canonical local stack"
	[ "$SECRET_STORE_DIR" = "$EXPECTED_SECRET_STORE_DIR" ] || fail "BT_SECRET_STORE_DIR must be the canonical state path $EXPECTED_SECRET_STORE_DIR"
	[ "$SECRET_STORE_NAMESPACE" = "$EXPECTED_SECRET_STORE_NAMESPACE" ] || fail "BT_SECRET_STORE_NAMESPACE must be $EXPECTED_SECRET_STORE_NAMESPACE"
	[ "$SECRET_MASTER_KEY_VERSION" = v1 ] || fail "BT_SECRET_MASTER_KEY_VERSION must be v1"
	[ "$BT_GATEWAY_URL" = "http://127.0.0.1:18082" ] || fail "BT_GATEWAY_URL must be http://127.0.0.1:18082"
}

ensure_token() {
	token_path=$1
	[ -f "$token_path" ] || {
		umask 077
		if command -v openssl >/dev/null 2>&1; then
			openssl rand -hex 32 >"$token_path"
		else
			LC_ALL=C od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$token_path"
			printf '\n' >>"$token_path"
		fi
	}
	chmod 600 "$token_path"
}

ensure_tokens() {
	ensure_token "$TOKEN_FILE"
	ensure_token "$GATEWAY_TOKEN_FILE"
	ensure_token "$MANUAL_PREVIEW_KEY_FILE"
	ensure_token "$SECRET_MASTER_KEY_FILE"
}

process_start_time() { ps -p "$1" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }
process_command() { ps -p "$1" -o command= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

write_command_identity() {
	service=$1
	command=$2
	command_file="$OWNERSHIP_DIR/$service.command"
	temporary="$command_file.tmp.$$"
	printf '%s\n' "$command" >"$temporary"
	mv "$temporary" "$command_file"
}

refresh_starting_identity() {
	service=$1
	pid_file="$PID_DIR/$service.pid"
	start_file="$OWNERSHIP_DIR/$service.start"
	starting_file="$OWNERSHIP_DIR/$service.starting"
	[ -f "$pid_file" ] && [ -f "$start_file" ] && [ -f "$starting_file" ] || return 1
	pid=$(sed -n '1p' "$pid_file")
	case "$pid" in *[!0-9]*|'') return 1 ;; esac
	kill -0 "$pid" 2>/dev/null || return 1
	[ "$(process_start_time "$pid")" = "$(sed -n '1p' "$start_file")" ] || return 1
	observed_command=$(process_command "$pid")
	[ -n "$observed_command" ] || return 1
	[ "$(process_start_time "$pid")" = "$(sed -n '1p' "$start_file")" ] || return 1
	write_command_identity "$service" "$observed_command"
}

is_owned() {
	service=$1
	pid_file="$PID_DIR/$service.pid"
	start_file="$OWNERSHIP_DIR/$service.start"
	command_file="$OWNERSHIP_DIR/$service.command"
	[ -f "$pid_file" ] && [ -f "$start_file" ] && [ -f "$command_file" ] || return 1
	pid=$(sed -n '1p' "$pid_file")
	case "$pid" in *[!0-9]*|'') return 1 ;; esac
	kill -0 "$pid" 2>/dev/null || return 1
	[ "$(process_start_time "$pid")" = "$(sed -n '1p' "$start_file")" ] || return 1
	[ "$(process_command "$pid")" = "$(sed -n '1p' "$command_file")" ] || return 1
}

is_owned_starting() {
	service=$1
	pid_file="$PID_DIR/$service.pid"
	start_file="$OWNERSHIP_DIR/$service.start"
	starting_file="$OWNERSHIP_DIR/$service.starting"
	[ -f "$pid_file" ] && [ -f "$start_file" ] && [ -f "$starting_file" ] || return 1
	pid=$(sed -n '1p' "$pid_file")
	case "$pid" in *[!0-9]*|'') return 1 ;; esac
	kill -0 "$pid" 2>/dev/null || return 1
	[ "$(process_start_time "$pid")" = "$(sed -n '1p' "$start_file")" ]
}

port_is_free() {
	port=$1; owner=$2
	if [ -n "${BT_DEV_PORT_CHECK_CMD:-}" ]; then sh -c "$BT_DEV_PORT_CHECK_CMD" -- "$port"; return; fi
	command -v lsof >/dev/null 2>&1 || fail "lsof is required for port ownership checks"
	listeners=$(lsof -nP -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | sort -u || true)
	[ -n "$listeners" ] || return 0
	is_owned "$owner" || return 1
	owned_pid=$(sed -n '1p' "$PID_DIR/$owner.pid")
	[ "$listeners" = "$owned_pid" ]
}

check_ports() {
	for binding in $FIXED_PORTS; do
		name=${binding%%:*}; port=${binding##*:}
		case "$name" in platform-browser|platform-work) owner=platform ;; *) owner=$name ;; esac
		port_is_free "$port" "$owner" || fail "required port $port ($name) is not bound exclusively by its owned process"
	done
}

validate_runtime_config() {
	for service in $SERVICES_START; do
		[ -n "$(configured_value "$service" CMD)" ] || fail "BT_DEV_$(service_key "$service")_CMD is required"
	done
	[ -n "$(configured_value funding-worker DRAIN_CMD)" ] || fail "BT_DEV_FUNDING_WORKER_DRAIN_CMD is required"
	if [ "${BT_DEV_TEST_HOOKS:-0}" != "1" ]; then
		[ -z "${BT_DEV_PORT_CHECK_CMD:-}" ] || fail "custom port checks require BT_DEV_TEST_HOOKS=1"
		for service in $SERVICES_START; do
			[ -z "$(configured_value "$service" READY_CMD)" ] || fail "custom readiness commands require BT_DEV_TEST_HOOKS=1"
		done
	fi
}

run_bootstrap() {
	db_bootstrap=${BT_DEV_DB_BOOTSTRAP_CMD:-./backend/scripts/db-bootstrap.sh}
	secret_bootstrap=${BT_DEV_SECRET_BOOTSTRAP_CMD:-./backend/scripts/secret-bootstrap.sh}
	if [ "${BT_DEV_TEST_HOOKS:-0}" != "1" ]; then
		[ "$db_bootstrap" = "./backend/scripts/db-bootstrap.sh" ] || fail "custom DB bootstrap requires BT_DEV_TEST_HOOKS=1"
		[ "$secret_bootstrap" = "./backend/scripts/secret-bootstrap.sh" ] || fail "custom Secret Store bootstrap requires BT_DEV_TEST_HOOKS=1"
	fi
	PGHOST=127.0.0.1 PGPORT=15432 sh -c "$db_bootstrap" || fail "database bootstrap failed"
	sh -c "$secret_bootstrap" || fail "Secret Store bootstrap failed"
}

authenticated_get() {
	token_path=$1
	url=$2
	{
		printf 'oauth2-bearer = "'
		tr -d '\r\n' <"$token_path"
		printf '"\n'
	} | curl --fail --silent --show-error --config - "$url" >/dev/null
}

funding_worker_generation() {
	[ -f "$OWNERSHIP_DIR/funding-worker.instance" ] || return 1
	instance_id=$(sed -n '1p' "$OWNERSHIP_DIR/funding-worker.instance")
	[ -n "$instance_id" ] || return 1
	body=$(printf '{"workerId":"%s","instanceId":"%s","productId":"funding","mode":"%s","contractVersion":"boltertrader-product-platform-upgrade/v5"}' "$WORKER_ID" "$instance_id" "$MODE")
	response=$({
		printf 'oauth2-bearer = "'
		tr -d '\r\n' <"$TOKEN_FILE"
		printf '"\n'
	} | curl --fail --silent --show-error --config - \
		--header 'Content-Type: application/json' \
		--header "Idempotency-Key: register:$WORKER_ID:$instance_id" \
		--data "$body" \
		http://127.0.0.1:18092/internal/v1/funding-work/workers/registrations) || return 1
	generation=$(printf '%s\n' "$response" | sed -n 's/.*"workerGeneration"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
	case "$generation" in ''|*[!0-9]*|0) return 1 ;; esac
	printf '%s\n' "$generation"
}

funding_worker_ready() {
	generation=$(funding_worker_generation) || return 1
	instance_id=$(sed -n '1p' "$OWNERSHIP_DIR/funding-worker.instance")
	{
		printf 'oauth2-bearer = "'
		tr -d '\r\n' <"$TOKEN_FILE"
		printf '"\n'
		printf 'header = "X-Worker-Id: %s"\n' "$WORKER_ID"
		printf 'header = "X-Worker-Generation: %s"\n' "$generation"
		printf 'header = "X-Worker-Instance-Id: %s"\n' "$instance_id"
	} | curl --fail --silent --show-error --config - \
		"http://127.0.0.1:18092/internal/v1/funding-work/workers/$WORKER_ID/readiness" >/dev/null
}

drain_funding_worker() {
	validate_mode; prepare_directories
	generation=$(funding_worker_generation) || fail "funding-worker generation is unavailable"
	instance_id=$(sed -n '1p' "$OWNERSHIP_DIR/funding-worker.instance")
	idempotency_key="supervisor-drain:$WORKER_ID:$instance_id:$generation"
	body=$(printf '{"workerGeneration":%s,"instanceId":"%s","idempotencyKey":"%s","reason":"shutdown"}' "$generation" "$instance_id" "$idempotency_key")
	{
		printf 'oauth2-bearer = "'
		tr -d '\r\n' <"$TOKEN_FILE"
		printf '"\n'
	} | curl --fail --silent --show-error --config - \
		--header 'Content-Type: application/json' \
		--header "Idempotency-Key: $idempotency_key" \
		--header "X-Worker-Id: $WORKER_ID" \
		--header "X-Worker-Generation: $generation" \
		--header "X-Worker-Instance-Id: $instance_id" \
		--data "$body" \
		"http://127.0.0.1:18092/internal/v1/funding-work/workers/$WORKER_ID/drain" >/dev/null
}

builtin_ready() {
	service=$1
	case "$service" in
		postgres)
			pg_isready -h 127.0.0.1 -p 15432 >/dev/null
			;;
		gateway)
			authenticated_get "$GATEWAY_TOKEN_FILE" http://127.0.0.1:18082/internal/v1/runtime/status &&
				authenticated_get "$GATEWAY_TOKEN_FILE" http://127.0.0.1:18082/internal/v1/runtime/readiness
			;;
		platform)
			curl --fail --silent --show-error http://127.0.0.1:18091/api/v1/system/status >/dev/null &&
				curl --fail --silent --show-error http://127.0.0.1:18091/api/v1/system/readiness >/dev/null &&
				authenticated_get "$TOKEN_FILE" http://127.0.0.1:18092/internal/v1/funding-work/status
			;;
		funding-worker)
			funding_worker_ready
			;;
		web)
			curl --fail --silent --show-error http://127.0.0.1:13001/ >/dev/null
			;;
	esac
}

fresh_instance_id() {
	if command -v uuidgen >/dev/null 2>&1; then uuidgen | tr '[:upper:]' '[:lower:]'; else
		LC_ALL=C od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; printf '\n'
	fi
}

start_service() {
	service=$1
	START_SERVICE_STATE=unknown
	if is_owned "$service"; then
		START_SERVICE_STATE=already-ready
		printf '%s already running\n' "$service"
		return
	fi
	command=$(configured_value "$service" CMD)
	[ -n "$command" ] || fail "BT_DEV_$(service_key "$service")_CMD is required"
	log_file="$LOG_DIR/$service.log"
	if [ "$service" = "funding-worker" ]; then
		instance_id=$(fresh_instance_id)
		nohup env -i PATH="${PATH:-/usr/bin:/bin}" FT_MODE="$MODE" \
			BT_PLATFORM_WORK_URL="${BT_PLATFORM_WORK_URL:-http://127.0.0.1:18092}" \
			BT_FUNDING_WORKER_TOKEN_FILE="$TOKEN_FILE" BT_FUNDING_WORKER_ID="$WORKER_ID" \
			BT_FUNDING_WORKER_INSTANCE_ID="$instance_id" BT_FUNDING_WORK_CONTRACT_VERSION="boltertrader-product-platform-upgrade/v5" \
			sh -c "exec $command" >>"$log_file" 2>&1 &
	elif [ "$service" = "web" ]; then
		nohup env -i PATH="${PATH:-/usr/bin:/bin}" FT_MODE="$MODE" \
			BT_WEB_LISTEN_ADDR="${BT_WEB_LISTEN_ADDR:-127.0.0.1:13001}" \
			BT_PLATFORM_BROWSER_URL="${BT_PLATFORM_BROWSER_URL:-http://127.0.0.1:18091/api/v1}" \
			sh -c "exec $command" >>"$log_file" 2>&1 &
	elif [ "$service" = "platform" ]; then
		nohup env BT_MODE="$BT_MODE" FT_MODE="$MODE" \
			BT_PLATFORM_DATABASE="$BT_PLATFORM_DATABASE" BT_PLATFORM_DATABASE_ROLE="$BT_PLATFORM_DATABASE_ROLE" \
			BT_MANUAL_PREVIEW_SIGNING_KEY_FILE="$MANUAL_PREVIEW_KEY_FILE" \
			BT_SECRET_KEY_SOURCE="$SECRET_KEY_SOURCE" BT_SECRET_STORE_DIR="$SECRET_STORE_DIR" \
			BT_SECRET_STORE_NAMESPACE="$SECRET_STORE_NAMESPACE" BT_SECRET_MASTER_KEY_VERSION="$SECRET_MASTER_KEY_VERSION" \
			BT_SECRET_MASTER_KEY_FILE="$SECRET_MASTER_KEY_FILE" BT_SECRET_KEYCHAIN_SERVICE= BT_SECRET_KEYCHAIN_ACCOUNT= \
			sh -c "exec $command" >>"$log_file" 2>&1 &
	else
		nohup sh -c "exec $command" >>"$log_file" 2>&1 &
	fi
	pid=$!
	printf '%s\n' "$pid" >"$PID_DIR/$service.pid"
	i=0
	while [ "$i" -lt 50 ]; do
		kill -0 "$pid" 2>/dev/null || fail "$service exited during startup; see $log_file"
		observed_start=$(process_start_time "$pid")
		observed_command=$(process_command "$pid")
		sleep 0.02
		if [ -n "$observed_start" ] && [ -n "$observed_command" ] &&
			[ "$observed_start" = "$(process_start_time "$pid")" ] &&
			[ "$observed_command" = "$(process_command "$pid")" ]; then
			break
		fi
		i=$((i + 1))
	done
	[ "$i" -lt 50 ] || fail "$service process identity did not stabilize"
	printf '%s\n' "$observed_start" >"$OWNERSHIP_DIR/$service.start"
	write_command_identity "$service" "$observed_command"
	printf 'starting\n' >"$OWNERSHIP_DIR/$service.starting"
	if [ "$service" = "funding-worker" ]; then printf '%s\n' "$instance_id" >"$OWNERSHIP_DIR/funding-worker.instance"; fi
	START_SERVICE_STATE=started
	printf '%s started\n' "$service"
}

wait_service() {
	service=$1; ready=$(configured_value "$service" READY_CMD)
	deadline=$(( $(date +%s) + START_TIMEOUT ))
	while :; do
		refresh_starting_identity "$service" || fail "$service is not an owned starting process"
		if { [ -n "$ready" ] && sh -c "$ready" >/dev/null 2>&1; } || { [ -z "$ready" ] && builtin_ready "$service"; }; then
			refresh_starting_identity "$service" || fail "$service identity changed at readiness"
			is_owned "$service" || fail "$service identity did not seal at readiness"
			rm -f "$OWNERSHIP_DIR/$service.starting"
			printf '%s ready\n' "$service"; return
		fi
		[ "$(date +%s)" -lt "$deadline" ] || fail "$service readiness timed out"
		sleep 1
	done
}

run_with_timeout() {
	limit=$1; shift; sh -c "exec $*" & command_pid=$!; deadline=$(( $(date +%s) + limit ))
	while kill -0 "$command_pid" 2>/dev/null; do
		if [ "$(date +%s)" -ge "$deadline" ]; then
			kill -TERM "$command_pid" 2>/dev/null || true; sleep 0.1
			kill -KILL "$command_pid" 2>/dev/null || true
			wait "$command_pid" 2>/dev/null || true
			return 1
		fi
		sleep 1
	done
	wait "$command_pid"
}

drain_worker() {
	is_owned funding-worker || return 0
	drain=$(configured_value funding-worker DRAIN_CMD)
	[ -n "$drain" ] || { printf 'dev-platform: funding-worker drain command is missing\n' >&2; return 1; }
	run_with_timeout "$DRAIN_TIMEOUT" "$drain" || { printf 'dev-platform: funding-worker drain failed or timed out\n' >&2; return 1; }
}

stop_service() {
	service=$1; pid_file="$PID_DIR/$service.pid"
	[ -f "$pid_file" ] || return 0
	if ! is_owned "$service" && ! is_owned_starting "$service"; then printf 'dev-platform: refusing to stop untrusted %s pid record\n' "$service" >&2; return 0; fi
	pid=$(sed -n '1p' "$pid_file"); kill -TERM "$pid"; deadline=$(( $(date +%s) + STOP_TIMEOUT ))
	while kill -0 "$pid" 2>/dev/null; do
		if [ "$(date +%s)" -ge "$deadline" ]; then { is_owned "$service" || is_owned_starting "$service"; } || fail "$service ownership changed during shutdown"; kill -KILL "$pid"; break; fi
		sleep 0.1
	done
	wait "$pid" 2>/dev/null || true
	rm -f "$pid_file" "$OWNERSHIP_DIR/$service.start" "$OWNERSHIP_DIR/$service.command" "$OWNERSHIP_DIR/$service.starting"
	[ "$service" != "funding-worker" ] || rm -f "$OWNERSHIP_DIR/funding-worker.instance"
	printf '%s stopped\n' "$service"
}

up() {
	validate_mode; prepare_directories; validate_runtime_config; check_ports; ensure_tokens
	trap 'rc=$?; trap - EXIT; if [ "$rc" -ne 0 ]; then down >/dev/null 2>&1 || true; fi; exit "$rc"' EXIT
	trap 'down >/dev/null 2>&1 || true' INT TERM HUP
	for service in $SERVICES_START; do
		start_service "$service"
		case "$START_SERVICE_STATE" in
			started) wait_service "$service" ;;
			already-ready) wait_owned_service "$service" ;;
			*) fail "$service returned an invalid start state" ;;
		esac
		[ "$service" != "postgres" ] || run_bootstrap
	done
	trap - EXIT INT TERM HUP
}

down() {
	validate_mode; prepare_directories; drain_failed=0
	for service in $SERVICES_STOP; do
		if [ "$service" = "funding-worker" ]; then drain_worker || drain_failed=1; fi
		stop_service "$service"
	done
	return "$drain_failed"
}

status() {
	validate_mode; prepare_directories; failed=0
	for service in $SERVICES_START; do
		if is_owned "$service"; then printf '%s running pid=%s\n' "$service" "$(sed -n '1p' "$PID_DIR/$service.pid")"; else printf '%s stopped-or-untrusted\n' "$service"; failed=1; fi
	done
	return "$failed"
}

wait_owned_service() {
	service=$1; ready=$(configured_value "$service" READY_CMD)
	deadline=$(( $(date +%s) + START_TIMEOUT ))
	while :; do
		is_owned "$service" || fail "$service is not an owned ready process"
		if { [ -n "$ready" ] && sh -c "$ready" >/dev/null 2>&1; } || { [ -z "$ready" ] && builtin_ready "$service"; }; then
			is_owned "$service" || fail "$service identity changed at readiness"
			printf '%s ready\n' "$service"; return
		fi
		[ "$(date +%s)" -lt "$deadline" ] || fail "$service readiness timed out"
		sleep 1
	done
}

wait_all() { for service in $SERVICES_START; do wait_owned_service "$service"; done; }

logs() {
	prepare_directories
	for service in $SERVICES_START; do log_file="$LOG_DIR/$service.log"; [ -f "$log_file" ] || continue; printf '==> %s <==\n' "$service"; tail -n "${BT_DEV_LOG_LINES:-50}" "$log_file"; done
}

doctor() {
	validate_mode; prepare_directories
	for tool in ps sed date sh; do command -v "$tool" >/dev/null 2>&1 || fail "required tool is missing: $tool"; done
	if [ "${BT_DEV_TEST_HOOKS:-0}" != "1" ]; then
		for tool in curl lsof pg_isready; do command -v "$tool" >/dev/null 2>&1 || fail "required runtime tool is missing: $tool"; done
		command -v openssl >/dev/null 2>&1 || command -v od >/dev/null 2>&1 || fail "openssl or od is required for token generation"
		[ -x ./backend/scripts/db-bootstrap.sh ] || fail "Lane 2 database bootstrap is missing or not executable"
		[ -x ./backend/scripts/secret-bootstrap.sh ] || fail "Lane 2 Secret Store bootstrap is missing or not executable"
		validate_runtime_config
	fi
	printf 'mode=%s\nruntime=%s\nworker-id=%s\nworker-token-file=%s\ngateway-token-file=%s\nmanual-preview-signing-key-file=%s\nsecret-key-source=%s\nsecret-store-dir=%s\nsecret-store-namespace=%s\nsecret-master-key-version=%s\nsecret-master-key-file=%s\ngateway-url=%s\nlive-private-writes=%s\nfixed-ports=%s\nstart-order=%s\nstop-order=%s\n' "$MODE" "$RUNTIME_DIR" "$WORKER_ID" "$TOKEN_FILE" "$GATEWAY_TOKEN_FILE" "$MANUAL_PREVIEW_KEY_FILE" "$SECRET_KEY_SOURCE" "$SECRET_STORE_DIR" "$SECRET_STORE_NAMESPACE" "$SECRET_MASTER_KEY_VERSION" "$SECRET_MASTER_KEY_FILE" "$BT_GATEWAY_URL" "$BT_LIVE_PRIVATE_WRITES_ENABLED" "$FIXED_PORTS" "$SERVICES_START" "$SERVICES_STOP"
}

reset() {
	down
	for service in $SERVICES_START; do [ ! -f "$PID_DIR/$service.pid" ] || fail "refusing reset while $service has an untrusted pid record"; done
	rm -rf "$STATE_DIR" "$SECRET_STORE_DIR/$MODE"; rm -f "$TOKEN_FILE" "$GATEWAY_TOKEN_FILE" "$MANUAL_PREVIEW_KEY_FILE" "$SECRET_MASTER_KEY_FILE"
}

case "${1:-}" in
	up) up ;; down) down ;; restart) down; up ;; status|ps) status ;; wait) wait_all ;;
	logs) logs ;; doctor) doctor ;; reset) reset ;; drain-funding-worker) drain_funding_worker ;;
	*) fail "usage: scripts/dev-platform {up|down|restart|status|wait|logs|ps|doctor|reset|drain-funding-worker}" ;;
esac
