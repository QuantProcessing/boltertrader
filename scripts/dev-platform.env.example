# Docker-free Test stack commands. Source this file from the repository root.
export FT_MODE=test
export FT_LOCAL_RUNTIME_DIR=/tmp/boltertrader-local
export BT_SECRET_KEY_SOURCE=file
export BT_SECRET_STORE_DIR="$FT_LOCAL_RUNTIME_DIR/secret-store"
export BT_SECRET_STORE_NAMESPACE=boltertrader/test
export BT_SECRET_MASTER_KEY_VERSION=v1
export BT_SECRET_MASTER_KEY_FILE="$FT_LOCAL_RUNTIME_DIR/credentials/test/secret-store-master.key"
export BT_DEV_POSTGRES_CMD='./scripts/dev-platform-service postgres'
export BT_DEV_GATEWAY_CMD='./scripts/dev-platform-service gateway'
export BT_DEV_PLATFORM_CMD='./scripts/dev-platform-service platform'
export BT_DEV_FUNDING_WORKER_CMD='./scripts/dev-platform-service funding-worker'
export BT_DEV_WEB_CMD='./scripts/dev-platform-service web'
export BT_DEV_FUNDING_WORKER_DRAIN_CMD='./scripts/dev-platform drain-funding-worker'
