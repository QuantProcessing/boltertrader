#!/bin/sh
set -eu

fail() { printf 'test-real: %s\n' "$*" >&2; exit 1; }

[ "${BT_DEV_REAL_STACK_ACCEPTANCE:-}" = 1 ] || fail "set BT_DEV_REAL_STACK_ACCEPTANCE=1 to attest the local Test stack"
[ "${FT_MODE:-}" = test ] || fail "FT_MODE must be test"
[ "${BT_DEV_ENABLE_LIVE_PRIVATE_WRITES:-0}" = 0 ] || fail "Live private writes must remain disabled"
[ "${BT_LIVE_PRIVATE_WRITES_ENABLED:-0}" = 0 ] || fail "Live private writes must remain disabled"
for name in $(env | sed -n 's/^\(BOLTER_ENABLE_[A-Z0-9_]*_WRITES\)=.*/\1/p'); do
	fail "$name must be unset"
done

for name in BT_DEV_REAL_USERNAME BT_DEV_REAL_PASSWORD BT_DEV_REAL_CREDENTIAL_CANARY BT_DEV_REAL_CREDENTIAL_SECRET_CANARY; do
	eval "value=\${$name:-}"
	[ -n "$value" ] || fail "$name is required"
done

PLATFORM_URL=${BT_DEV_REAL_PLATFORM_URL:-http://127.0.0.1:13002/}
HARNESS_URL=${BT_DEV_REAL_TEST_HARNESS_RESNAPSHOT_URL:-http://127.0.0.1:13002/__bt/resnapshot}
[ "$PLATFORM_URL" = http://127.0.0.1:13002/ ] || fail "BT_DEV_REAL_PLATFORM_URL must be http://127.0.0.1:13002/"
[ "$HARNESS_URL" = http://127.0.0.1:13002/__bt/resnapshot ] || fail "BT_DEV_REAL_TEST_HARNESS_RESNAPSHOT_URL must be http://127.0.0.1:13002/__bt/resnapshot"

RUNTIME_DIR=${FT_LOCAL_RUNTIME_DIR:-/tmp/boltertrader-local}
STATE_DIR="$RUNTIME_DIR/state/test"
EVIDENCE_ROOT=${BT_DEV_REAL_EVIDENCE_DIR:-$RUNTIME_DIR/evidence/test-real}
case "$EVIDENCE_ROOT" in /*) ;; *) fail "BT_DEV_REAL_EVIDENCE_DIR must be absolute" ;; esac
[ ! -L "$EVIDENCE_ROOT" ] || fail "BT_DEV_REAL_EVIDENCE_DIR must not be a symlink"
umask 077
mkdir -p "$EVIDENCE_ROOT"
chmod 700 "$EVIDENCE_ROOT"
RUN_DIR="$EVIDENCE_ROOT/$(date -u '+%Y%m%dT%H%M%SZ')-$$"
mkdir "$RUN_DIR"
chmod 700 "$RUN_DIR"

PLATFORM_SERVICE=${BT_DEV_REAL_PLATFORM_SERVICE:-platform_target_test}
PLATFORM_DATABASE=${BT_DEV_REAL_PLATFORM_DATABASE:-bolter_platform_test}
GATEWAY_SERVICE=${BT_DEV_REAL_GATEWAY_SERVICE:-gateway_test}
GATEWAY_DATABASE=${BT_DEV_REAL_GATEWAY_DATABASE:-bolter_gateway_test}
[ "$PLATFORM_SERVICE" = platform_target_test ] || fail "BT_DEV_REAL_PLATFORM_SERVICE must be platform_target_test"
[ "$PLATFORM_DATABASE" = bolter_platform_test ] || fail "BT_DEV_REAL_PLATFORM_DATABASE must be bolter_platform_test"
[ "$GATEWAY_SERVICE" = gateway_test ] || fail "BT_DEV_REAL_GATEWAY_SERVICE must be gateway_test"
[ "$GATEWAY_DATABASE" = bolter_gateway_test ] || fail "BT_DEV_REAL_GATEWAY_DATABASE must be bolter_gateway_test"

NPM=${BT_DEV_REAL_NPM:-npm}
MIGRATION_TOOL=${BT_DEV_REAL_MIGRATION_TOOL:-}
if [ -n "${BT_DEV_REAL_NPM:-}" ] || [ -n "$MIGRATION_TOOL" ]; then
	[ "${BT_DEV_TEST_HOOKS:-0}" = 1 ] || fail "custom commands require BT_DEV_TEST_HOOKS=1"
fi

migration_tool() {
	if [ -n "$MIGRATION_TOOL" ]; then
		"$MIGRATION_TOOL" "$@"
	else
		go run ./cmd/migration-tool "$@"
	fi
}

capture_validation_snapshot() {
	output=$1
	FT_MODE=test migration_tool validation-snapshot \
		--platform-service "$PLATFORM_SERVICE" --platform-database "$PLATFORM_DATABASE" \
		--gateway-service "$GATEWAY_SERVICE" --gateway-database "$GATEWAY_DATABASE" \
		--output "$output" >"$output.stdout"
	chmod 600 "$output" "$output.stdout"
}

IDENTITY_OUTPUT=
capture_owned_identity() {
	service=$1
	for suffix in pid; do
		path="$STATE_DIR/pids/$service.$suffix"
		[ -f "$path" ] && [ ! -L "$path" ] || fail "$service $suffix identity is unavailable"
		printf '%s.%s=%s\n' "$service" "$suffix" "$(sed -n '1p' "$path")" >>"$IDENTITY_OUTPUT"
	done
	for suffix in start command; do
		path="$STATE_DIR/ownership/$service.$suffix"
		[ -f "$path" ] && [ ! -L "$path" ] || fail "$service $suffix identity is unavailable"
		printf '%s.%s=%s\n' "$service" "$suffix" "$(sed -n '1p' "$path")" >>"$IDENTITY_OUTPUT"
	done
}

capture_process_identities() {
	label=$1
	IDENTITY_OUTPUT="$RUN_DIR/process-$label.txt"
	: >"$IDENTITY_OUTPUT"
	capture_owned_identity "postgres"
	capture_owned_identity "gateway"
	capture_owned_identity "platform"
	capture_owned_identity "funding-worker"
	capture_owned_identity "web"
	chmod 600 "$IDENTITY_OUTPUT"
}

HARNESS_PID=
cleanup_harness() {
	[ -n "$HARNESS_PID" ] || return 0
	if kill -0 "$HARNESS_PID" 2>/dev/null; then kill -TERM "$HARNESS_PID" 2>/dev/null || true; fi
	wait "$HARNESS_PID" 2>/dev/null || true
	HARNESS_PID=
}
trap cleanup_harness EXIT INT TERM HUP

./scripts/dev-platform doctor
./scripts/dev-platform status
./scripts/dev-platform wait
curl --fail --silent --show-error http://127.0.0.1:18091/api/v1/system/readiness >/dev/null
curl --fail --silent --show-error http://127.0.0.1:13001/ >/dev/null

capture_process_identities before
capture_validation_snapshot "$RUN_DIR/validation-before.json"

if command -v lsof >/dev/null 2>&1 && lsof -nP -t -iTCP:13002 -sTCP:LISTEN >/dev/null 2>&1; then
	fail "resnapshot harness port 13002 is already in use"
fi
BT_DEV_REAL_TEST_HARNESS_ACCEPT=1 FT_MODE=test \
	BT_DEV_ENABLE_LIVE_PRIVATE_WRITES=0 BT_LIVE_PRIVATE_WRITES_ENABLED=0 \
	BT_DEV_REAL_TEST_HARNESS_HOST=127.0.0.1 BT_DEV_REAL_TEST_HARNESS_PORT=13002 \
	BT_DEV_REAL_TEST_HARNESS_UPSTREAM_URL=http://127.0.0.1:13001/ \
	"$NPM" --prefix web run test:e2e:real:harness >"$RUN_DIR/resnapshot-harness.log" 2>&1 &
HARNESS_PID=$!
chmod 600 "$RUN_DIR/resnapshot-harness.log"

attempt=0
until curl --fail --silent --show-error "$PLATFORM_URL" >/dev/null 2>&1; do
	kill -0 "$HARNESS_PID" 2>/dev/null || fail "resnapshot harness exited during startup"
	[ "$attempt" -lt 100 ] || fail "resnapshot harness readiness timed out"
	attempt=$((attempt + 1))
	sleep 0.1
done

BT_DEV_REAL_BROWSER_ACCEPTANCE=1 FT_MODE=test \
	BT_DEV_ENABLE_LIVE_PRIVATE_WRITES=0 BT_LIVE_PRIVATE_WRITES_ENABLED=0 \
	BT_DEV_REAL_PLATFORM_URL=http://127.0.0.1:13002/ \
	BT_DEV_REAL_TEST_HARNESS_RESNAPSHOT_URL=http://127.0.0.1:13002/__bt/resnapshot \
	"$NPM" --prefix web run test:e2e:real

curl --fail --silent --show-error --request POST \
	--header 'Idempotency-Key: g010-real-browser-resnapshot' \
	"$HARNESS_URL" >"$RUN_DIR/resnapshot-result.json"
chmod 600 "$RUN_DIR/resnapshot-result.json"
grep -q '"triggerCount":1' "$RUN_DIR/resnapshot-result.json" || fail "resnapshot trigger count is not exactly one"
grep -q '"canonicalMutationCount":0' "$RUN_DIR/resnapshot-result.json" || fail "resnapshot harness observed a canonical mutation"
grep -q '"activeHeadMutationCount":0' "$RUN_DIR/resnapshot-result.json" || fail "resnapshot harness observed a Gateway active-head mutation"
browser_session_digest=$(sed -n 's/.*"browserSessionDigest":"\([^"]*\)".*/\1/p' "$RUN_DIR/resnapshot-result.json")
[ -n "$browser_session_digest" ] || fail "resnapshot harness did not report browserSessionDigest"

capture_validation_snapshot "$RUN_DIR/validation-after.json"
FT_MODE=test migration_tool validation-compare \
	--before "$RUN_DIR/validation-before.json" --after "$RUN_DIR/validation-after.json" \
	--allowed-session-id "$browser_session_digest" >"$RUN_DIR/validation-comparison.json"
chmod 600 "$RUN_DIR/validation-comparison.json"
capture_process_identities after
cmp "$RUN_DIR/process-before.txt" "$RUN_DIR/process-after.txt" >/dev/null || fail "owned process identity changed during browser validation"

cleanup_harness
curl --fail --silent --show-error http://127.0.0.1:18091/api/v1/system/readiness >/dev/null
curl --fail --silent --show-error http://127.0.0.1:13001/ >/dev/null
printf 'test-real: G010 no-trade local Test stack and one snapshot-bound browser cycle passed; no venue writes were performed\n'
printf 'test-real: G011 Test-write remains a separate explicit credentialed handoff\n'
