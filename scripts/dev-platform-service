#!/bin/sh
set -eu

fail() { printf 'dev-platform-service: %s\n' "$*" >&2; exit 1; }

service=${1:-}
runtime_dir=${FT_LOCAL_RUNTIME_DIR:-/tmp/boltertrader-local}
mode=${FT_MODE:-test}
[ "$mode" = test ] || fail "canonical commands support FT_MODE=test only"
bin_dir="$runtime_dir/bin/test"
mkdir -p "$bin_dir"
chmod 700 "$bin_dir"

build_go() {
	output=$1
	package=$2
	go build -o "$output.tmp" "$package"
	chmod 700 "$output.tmp"
	mv "$output.tmp" "$output"
}

build_backend_go() {
	output=$1
	package=$2
	(
		cd backend
		go build -o "$output.tmp" "$package"
	)
	chmod 700 "$output.tmp"
	mv "$output.tmp" "$output"
}

case "$service" in
	postgres)
		data_dir="$runtime_dir/postgres/test"
		if [ ! -s "$data_dir/PG_VERSION" ]; then
			command -v initdb >/dev/null 2>&1 || fail "initdb is required"
			mkdir -p "$data_dir"
			chmod 700 "$data_dir"
			initdb --auth-local=trust --auth-host=trust -D "$data_dir" >/dev/null
		fi
		exec postgres -D "$data_dir" -h 127.0.0.1 -p 15432
		;;
	gateway)
		build_go "$bin_dir/exchange-gateway" ./cmd/exchange-gateway
		token_file="$runtime_dir/credentials/test/gateway-adapter.token"
		[ -s "$token_file" ] || fail "gateway token file is missing"
		BT_DEV_GATEWAY_TOKEN=$(tr -d '\r\n' <"$token_file")
		BT_DEV_GATEWAY_POSTGRES_DSN='postgres://bolter_gateway_test@127.0.0.1:15432/bolter_gateway_test?sslmode=disable'
		BT_GATEWAY_DATABASE=bolter_gateway_test
		BT_GATEWAY_DATABASE_ROLE=bolter_gateway_test
		export BT_DEV_GATEWAY_TOKEN BT_DEV_GATEWAY_POSTGRES_DSN BT_GATEWAY_DATABASE BT_GATEWAY_DATABASE_ROLE
		case "${BT_GATEWAY_STARTUP_PROFILE:-normal}" in
			normal) gateway_config=gateway/dev-platform.test.yaml ;;
			migration-validation) gateway_config=gateway/dev-platform.validation.test.yaml ;;
			*) fail "BT_GATEWAY_STARTUP_PROFILE must be normal or migration-validation" ;;
		esac
		exec "$bin_dir/exchange-gateway" -config "$gateway_config"
		;;
	platform)
		build_backend_go "$bin_dir/platform-api" ./cmd/platform-api
		exec "$bin_dir/platform-api"
		;;
	funding-worker)
		build_backend_go "$bin_dir/funding-worker" ./cmd/funding-worker
		exec "$bin_dir/funding-worker"
		;;
	web)
		command -v npm >/dev/null 2>&1 || fail "npm is required"
		npm --prefix web run build
		exec node web/server.mjs
		;;
	*) fail "usage: scripts/dev-platform-service {postgres|gateway|platform|funding-worker|web}" ;;
esac
