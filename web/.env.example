# Origin the dev server proxies /api to. This is the auth edge, never the
# gateway and never trading directly — the auth edge is what exchanges a
# browser session for the downstream service token and principal headers.
BT_WEB_API_ORIGIN=http://127.0.0.1:18091

# Base URL Playwright drives. Point it at a running `npm run dev`, or leave it
# and let the config start one.
BT_WEB_E2E_BASE_URL=http://127.0.0.1:5173
