FT_MODE=test
FT_STARTUP_MODE=serve
FT_HTTP_ADDR=127.0.0.1:8080
FT_DATABASE_URL=postgres://funding_trader:replace-me@127.0.0.1:15432/funding_trader
FT_GATEWAY_BASE_URL=http://127.0.0.1:18082
FT_GATEWAY_TOKEN_FILE=/run/secrets/GATEWAY_AUTH_TOKEN
FT_SESSION_TTL=24h
FT_COOKIE_SECURE=false
FT_PRODUCTION_WRITES_ENABLED=false
FT_MARKET_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT
FT_BOOTSTRAP_EMAIL=owner@example.com
FT_BOOTSTRAP_PASSWORD=

# Database-free operator maintenance:
# FT_STARTUP_MODE=maintenance
# FT_MAINTENANCE_REASON=product_mode_cutover

# Migration-only cutover. Gateway and bootstrap credentials are intentionally
# not required in this mode. Supply these values only after the old service is
# stopped, automatic restart is disabled, and the backup checksum is verified.
# FT_STARTUP_MODE=migrate
# FT_CUTOVER_DATABASE_URL=postgres://funding_trader_cutover:replace-me@127.0.0.1:15432/funding_trader
# FT_CUTOVER_BACKUP_ID=backup-20260730-001
# FT_CUTOVER_BACKUP_SHA256=
# FT_CUTOVER_BACKUP_VERIFIED_AT=2026-07-30T07:00:00Z
# FT_CUTOVER_OLD_SERVICE_STOPPED=true
# FT_CUTOVER_AUTO_RESTART_DISABLED=true
