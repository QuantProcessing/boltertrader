{
  "name": "funding-arb-terminal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vinext/dist/cli.js dev",
    "build": "node ./node_modules/vinext/dist/cli.js build",
    "test": "node --test ./scripts/*.test.mjs",
    "test:evidence": "node --test ./scripts/acceptance-evidence.test.mjs ./scripts/acceptance-evidence-cli.test.mjs",
    "validate:evidence": "node ./scripts/validate-browser-evidence.mjs",
    "verify": "npm run test && npm run build",
    "start": "node ./node_modules/vinext/dist/cli.js start",
    "preview": "node ./node_modules/vinext/dist/cli.js start"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
