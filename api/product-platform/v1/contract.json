{
  "$schema": "./contract.schema.json",
  "schemaVersion": 1,
  "contractVersion": "boltertrader-product-platform-upgrade/v5",
  "revision": 5,
  "status": "frozen",
  "sources": [
    ".omx/plans/api-contract-boltertrader-product-platform-upgrade.md",
    ".omx/plans/local-runtime-contract-boltertrader-product-platform-upgrade.md",
    ".omx/plans/migration-contract-boltertrader-product-platform-upgrade.md"
  ],
  "conventions": {
    "jsonFieldCase": "camelCase",
    "decimalEncoding": "string",
    "timestampEncoding": "RFC3339 UTC",
    "modes": ["test", "live"],
    "venueEnvironments": ["demo", "testnet", "live"],
    "testIncludes": ["demo", "testnet"],
    "livePrivateWritesEnabledByDefault": false,
    "mutationResponsesRequireRequestId": true,
    "streamEventsRequire": ["eventId", "sequence", "cursor", "observedAt"]
  },
  "authority": {
    "browserReceivesGatewayCredential": false,
    "browserReceivesSecretValue": false,
    "workerReceivesGatewayCredential": false,
    "workerReceivesDatabaseCredential": false,
    "workerReceivesSecretStoreCredential": false,
    "gatewayAcceptsSecretMaterial": false,
    "gatewayAcceptsOpaqueSecretReference": true,
    "platformOwns": ["reservations", "commands", "workItems", "leases", "facts", "portfolio", "ledger", "pnl", "audit"],
    "gatewayOwns": ["desiredAccountRuntime", "runtimeFacts", "catalogFacts", "marketDataFacts", "privateEvents", "venueWrites"],
    "workerOwns": ["ephemeralFundingComputation"]
  },
  "schemaIdentifiers": [
    "MetaEnvelope",
    "ErrorEnvelope",
    "AccountCore",
    "SecretReference",
    "AccountDesiredStateCore",
    "AccountRuntimeCore",
    "AccountCapabilityCore",
    "RotationFenceCore",
    "NettingScope",
    "ReservationCore",
    "CommandCore",
    "FillCore",
    "FundingPaymentCore",
    "PnLCore",
    "RealtimeEventCore",
    "ActivityEventCore",
    "FundingReservationScopeRequirementCore",
    "FundingReservationRequirementCore",
    "WorkerRegistrationCore",
    "AccountFenceCore",
    "FundingWorkItemCore",
    "WorkLeaseCore",
    "FundingFactPageCore",
    "FundingCommandIntentCore",
    "WorkTerminalCore",
    "WorkerReadinessCore"
  ],
  "stableWorkerErrors": {
    "WORKER_AUTH_REQUIRED": false,
    "WORKER_SCOPE_DENIED": false,
    "WORKER_ALREADY_ACTIVE": true,
    "WORKER_GENERATION_STALE": false,
    "WORKER_NOT_READY": true,
    "WORKER_DRAINING": false,
    "WORK_LEASE_EXPIRED": false,
    "WORK_LEASE_STALE": false,
    "WORK_REVISION_CONFLICT": true,
    "WORK_AUTHORIZATION_STALE": true,
    "RESNAPSHOT_REQUIRED": true,
    "WORK_ATTEMPTS_EXHAUSTED": false,
    "IDEMPOTENCY_CONFLICT": false,
    "LIVE_PRIVATE_WRITE_DISABLED": false
  },
  "stableWorkerHTTPStatus": {
    "WORKER_AUTH_REQUIRED": 401,
    "WORKER_SCOPE_DENIED": 403,
    "WORKER_ALREADY_ACTIVE": 409,
    "WORKER_GENERATION_STALE": 409,
    "WORKER_NOT_READY": 503,
    "WORKER_DRAINING": 409,
    "WORK_LEASE_EXPIRED": 409,
    "WORK_LEASE_STALE": 409,
    "WORK_REVISION_CONFLICT": 409,
    "WORK_AUTHORIZATION_STALE": 409,
    "RESNAPSHOT_REQUIRED": 409,
    "WORK_ATTEMPTS_EXHAUSTED": 409,
    "IDEMPOTENCY_CONFLICT": 409,
    "LIVE_PRIVATE_WRITE_DISABLED": 403
  },
  "fencing": {
    "intentValidationOrder": [
      "authenticateAndScope",
      "workerGenerationAndReadiness",
      "leaseAndWorkRevision",
      "accountFencesAndFactsCursor",
      "idempotency",
      "liveDenialAndProductPolicy",
      "commandCreation",
      "gatewayHandoff"
    ],
    "sideEffectFreeErrors": [
      "WORKER_GENERATION_STALE",
      "WORK_LEASE_EXPIRED",
      "WORK_LEASE_STALE",
      "WORK_REVISION_CONFLICT",
      "WORK_AUTHORIZATION_STALE",
      "RESNAPSHOT_REQUIRED"
    ],
    "effectsForbiddenBeforeValidation": [
      "workClaimCommit",
      "leaseRenewal",
      "idempotencyCommit",
      "reservationMutation",
      "commandCreation",
      "gatewayHandoff"
    ]
  },
  "listeners": [
    {
      "id": "platform-browser",
      "address": "127.0.0.1:18091",
      "namespace": "/api/v1",
      "acceptedPrincipals": ["browser-session"],
      "rejectedPrincipals": ["funding-worker", "gateway-adapter"],
      "routes": [
        "POST /api/v1/auth/login",
        "GET /api/v1/auth/session",
        "DELETE /api/v1/auth/session",
        "GET /api/v1/me",
        "GET /api/v1/system/status",
        "GET /api/v1/system/readiness",
        "GET /api/v1/accounts",
        "POST /api/v1/accounts",
        "GET /api/v1/accounts/{accountId}",
        "PATCH /api/v1/accounts/{accountId}",
        "POST /api/v1/accounts/{accountId}/validate",
        "POST /api/v1/accounts/{accountId}/rotate",
        "POST /api/v1/accounts/{accountId}/disable",
        "POST /api/v1/accounts/{accountId}/drain",
        "DELETE /api/v1/accounts/{accountId}",
        "GET /api/v1/accounts/{accountId}/runtimes",
        "GET /api/v1/catalog/venues",
        "GET /api/v1/catalog/instruments",
        "GET /api/v1/market-data",
        "GET /api/v1/reservations",
        "POST /api/v1/reservations",
        "DELETE /api/v1/reservations/{reservationId}",
        "GET /api/v1/commands",
        "POST /api/v1/commands",
        "GET /api/v1/commands/{commandId}",
        "GET /api/v1/products/funding/opportunities",
        "GET /api/v1/products/funding/opportunities/{opportunityId}",
        "POST /api/v1/products/funding/execution-previews",
        "POST /api/v1/products/funding/commands",
        "GET /api/v1/products/funding/commands/{commandId}",
        "GET /api/v1/products/funding/lineage/{lineageId}",
        "GET /api/v1/products/manual/venues",
        "POST /api/v1/products/manual/execution-previews",
        "POST /api/v1/products/manual/commands",
        "GET /api/v1/products/manual/orders",
        "GET /api/v1/products/manual/orders/{orderId}",
        "GET /api/v1/fills",
        "GET /api/v1/positions",
        "GET /api/v1/ledger",
        "GET /api/v1/pnl",
        "GET /api/v1/activity",
        "GET /api/v1/audit",
        "GET /api/v1/realtime/stream"
      ]
    },
    {
      "id": "platform-funding-work",
      "address": "127.0.0.1:18092",
      "namespace": "/internal/v1/funding-work",
      "acceptedPrincipals": ["funding-worker"],
      "rejectedPrincipals": ["browser-session", "gateway-adapter"],
      "routes": [
        "GET /internal/v1/funding-work/status",
        "POST /internal/v1/funding-work/workers/registrations",
        "PUT /internal/v1/funding-work/workers/{workerId}/heartbeat",
        "GET /internal/v1/funding-work/workers/{workerId}/readiness",
        "POST /internal/v1/funding-work/workers/{workerId}/drain",
        "POST /internal/v1/funding-work/claims",
        "GET /internal/v1/funding-work/facts",
        "GET /internal/v1/funding-work/facts/snapshot",
        "POST /internal/v1/funding-work/leases/{leaseId}/renew",
        "POST /internal/v1/funding-work/leases/{leaseId}/command-intents",
        "POST /internal/v1/funding-work/leases/{leaseId}/complete",
        "POST /internal/v1/funding-work/leases/{leaseId}/fail"
      ]
    },
    {
      "id": "gateway-internal",
      "address": "127.0.0.1:18082",
      "namespace": "/internal/v1",
      "acceptedPrincipals": ["gateway-adapter"],
      "rejectedPrincipals": ["browser-session", "funding-worker"],
      "routes": [
        "GET /internal/v1/runtime/status",
        "GET /internal/v1/runtime/readiness",
        "GET /internal/v1/runtime/open-orders",
        "GET /internal/v1/runtime/positions",
        "GET /internal/v1/runtime/uncertain-commands",
        "GET /internal/v1/accounts/desired",
        "GET /internal/v1/accounts/desired/{accountId}",
        "PUT /internal/v1/accounts/desired/{accountId}/operations/{operationId}",
        "PUT /internal/v1/accounts/desired/{accountId}/retirements/{operationId}",
        "GET /internal/v1/accounts/runtime",
        "GET /internal/v1/accounts/runtime/{accountId}",
        "GET /internal/v1/accounts/runtime/{accountId}/events",
        "GET /internal/v1/catalog/venues",
        "GET /internal/v1/catalog/instruments",
        "GET /internal/v1/market-data",
        "GET /internal/v1/private-events"
      ]
    }
  ],
  "strictMutations": {
    "POST /api/v1/auth/login": ["username", "password"],
    "POST /api/v1/accounts": ["venue", "displayName", "productIds", "routes", "credentialBundle"],
    "PATCH /api/v1/accounts/{accountId}": ["displayName", "productIds"],
    "POST /api/v1/accounts/{accountId}/validate": [],
    "POST /api/v1/accounts/{accountId}/rotate": ["credentialBundle"],
    "POST /api/v1/accounts/{accountId}/disable": [],
    "POST /api/v1/accounts/{accountId}/drain": [],
    "DELETE /api/v1/accounts/{accountId}": [],
    "POST /api/v1/reservations": ["accountId", "productId", "reservationKind", "nettingScope", "quantity", "notional", "currency", "mode"],
    "POST /api/v1/commands": ["accountId", "productId", "lineageId", "reservationId", "idempotencyKey", "commandKind", "mode", "payload"],
    "POST /api/v1/products/funding/execution-previews": ["opportunityId", "longAccountId", "shortAccountId", "canonicalMarketId", "notionalPerLeg", "maxSlippageBps", "holdThroughSettlement", "mode"],
    "POST /api/v1/products/funding/commands": ["previewId", "action", "lineageId", "idempotencyKey"],
    "POST /api/v1/products/manual/execution-previews": ["accountId", "instrumentId", "side", "orderType", "quantity", "limitPrice", "timeInForce", "reduceOnly", "mode"],
    "POST /api/v1/products/manual/commands": ["previewId", "action", "lineageId", "orderId", "idempotencyKey"],
    "POST /internal/v1/funding-work/workers/registrations": ["workerId", "instanceId", "productId", "mode", "contractVersion"],
    "PUT /internal/v1/funding-work/workers/{workerId}/heartbeat": ["workerGeneration", "instanceId", "state", "activeLeaseIds", "lastAppliedFactsCursor"],
    "POST /internal/v1/funding-work/workers/{workerId}/drain": ["workerGeneration", "instanceId", "idempotencyKey", "reason"],
    "POST /internal/v1/funding-work/claims": ["workerId", "workerGeneration", "instanceId", "idempotencyKey", "afterCursor", "waitSeconds", "maxItems"],
    "POST /internal/v1/funding-work/leases/{leaseId}/renew": ["workerId", "workerGeneration", "workItemId", "workRevision", "leaseGeneration", "idempotencyKey"],
    "POST /internal/v1/funding-work/leases/{leaseId}/command-intents": ["workerId", "workerGeneration", "workItemId", "workRevision", "leaseGeneration", "idempotencyKey", "intentKind", "factsCursor", "accountFences", "payload"],
    "POST /internal/v1/funding-work/leases/{leaseId}/complete": ["workerId", "workerGeneration", "workItemId", "workRevision", "leaseGeneration", "idempotencyKey", "factsCursor", "result"],
    "POST /internal/v1/funding-work/leases/{leaseId}/fail": ["workerId", "workerGeneration", "workItemId", "workRevision", "leaseGeneration", "idempotencyKey", "factsCursor", "errorCode", "retryable", "details"],
    "PUT /internal/v1/accounts/desired/{accountId}/operations/{operationId}": ["operationId", "accountId", "venue", "nativeEnvironment", "secretRef", "desiredStateRevision", "runtimeGeneration", "credentialVersion", "requestedState", "routes"],
    "PUT /internal/v1/accounts/desired/{accountId}/retirements/{operationId}": ["operationId", "accountId", "desiredStateRevision", "runtimeGeneration", "credentialVersion"]
  },
  "strictNestedPayloads": {
    "nettingScope": ["accountId", "venue", "instrumentId", "positionMode", "settlementScope", "venueEnvironment"],
    "funding.reservationScopeRequirement": ["accountId", "productId", "reservationKind", "nettingScope", "mode"],
    "funding.reservationRequirement": ["accountId", "productId", "reservationKind", "nettingScope", "quantity", "notional", "currency", "mode"],
    "work.open": ["opportunityId", "previewId", "longAccountId", "shortAccountId", "canonicalMarketId", "notionalPerLeg", "maxSlippageBps", "holdThroughSettlement"],
    "work.close": ["lineageId", "reason", "requestedAt"],
    "work.compensate": ["lineageId", "failedCommandId", "survivingCommandId", "maxCompensationNotional", "reason"],
    "work.reconcile": ["lineageId", "commandIds", "reason"],
    "work.observeSettlement": ["lineageId", "settlementPeriodEnd", "accountIds", "expectedFundingPaymentIds"],
    "intent.funding.open": ["previewId", "opportunityId", "longAccountId", "shortAccountId", "canonicalMarketId", "notionalPerLeg", "maxSlippageBps", "holdThroughSettlement"],
    "intent.funding.close": ["lineageId", "reason"],
    "intent.funding.compensate": ["lineageId", "failedCommandId", "survivingCommandId", "maxCompensationNotional", "reason"],
    "intent.funding.reconcile": ["lineageId", "commandIds", "reason"],
    "complete.result": ["outcome", "commandIds", "finalFactsCursor", "summaryCode"],
    "fail.details": ["blockerCodes", "commandIds", "lastSafeState"]
  },
  "runtime": {
    "processStartOrder": ["postgres", "gateway", "platform", "funding-worker", "web"],
    "processStopOrder": ["web", "funding-worker", "platform", "gateway", "postgres"],
    "ports": {
      "postgres": 15432,
      "gateway": 18082,
      "platformBrowser": 18091,
      "platformFundingWork": 18092,
      "web": 13001
    },
    "worker": {
      "heartbeatIntervalSeconds": 5,
      "heartbeatTTLSeconds": 15,
      "leaseDurationSeconds": 30,
      "maxAttempts": 5,
      "retryBackoffSeconds": [1, 2, 4, 8],
      "claimMaxItems": 1,
      "tokenFiles": {
        "test": "$FT_LOCAL_RUNTIME_DIR/credentials/test/funding-worker.token",
        "live": "$FT_LOCAL_RUNTIME_DIR/credentials/live/funding-worker.token"
      },
      "tokenValuesMustDifferAcrossModes": true,
      "requiredEnvironment": ["BT_PLATFORM_WORK_URL", "BT_FUNDING_WORKER_TOKEN_FILE", "BT_FUNDING_WORKER_ID", "BT_FUNDING_WORKER_INSTANCE_ID", "BT_FUNDING_WORK_CONTRACT_VERSION", "FT_MODE"],
      "forbiddenEnvironment": ["BT_GATEWAY_URL", "BT_GATEWAY_TOKEN", "DATABASE_URL", "DB_DSN", "BT_SECRET_MASTER_KEY_FILE", "TRADING_SECRET", "TRADING_SECRET_REF"]
    },
    "modeIsolation": {
      "crossModeReuseAllowed": false,
      "resources": [
        "workerTokenFile",
        "workerTokenValue",
        "workerRegistration",
        "factsCursor",
        "workItem",
        "lease",
        "database",
        "ownerRole",
        "secretStoreNamespace",
        "secretStoreMasterKey",
        "idempotencyNamespace",
        "auditScope"
      ]
    },
    "databases": [
      {"mode": "test", "component": "platform", "database": "bolter_platform_test", "ownerRole": "bolter_platform_test"},
      {"mode": "test", "component": "gateway", "database": "bolter_gateway_test", "ownerRole": "bolter_gateway_test"},
      {"mode": "live", "component": "platform", "database": "bolter_platform_live", "ownerRole": "bolter_platform_live"},
      {"mode": "live", "component": "gateway", "database": "bolter_gateway_live", "ownerRole": "bolter_gateway_live"}
    ]
  }
}
