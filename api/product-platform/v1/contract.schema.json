{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boltertrader.dev/schemas/product-platform-contract-v1.json",
  "title": "BolterTrader Product Platform Frozen Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractVersion", "revision", "status", "sources", "conventions", "authority", "schemaIdentifiers", "stableWorkerErrors", "stableWorkerHTTPStatus", "fencing", "listeners", "strictMutations", "strictNestedPayloads", "runtime"],
  "properties": {
    "$schema": {"type": "string", "const": "./contract.schema.json"},
    "schemaVersion": {"type": "integer", "const": 1},
    "contractVersion": {"type": "string", "const": "boltertrader-product-platform-upgrade/v4"},
    "revision": {"type": "integer", "const": 4},
    "status": {"type": "string", "const": "frozen"},
    "sources": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conventions": {"$ref": "#/$defs/conventions"},
    "authority": {"$ref": "#/$defs/authority"},
    "schemaIdentifiers": {"$ref": "#/$defs/schemaIdentifiers"},
    "stableWorkerErrors": {
      "type": "object",
      "minProperties": 14,
      "additionalProperties": {"type": "boolean"},
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]+$"}
    },
    "stableWorkerHTTPStatus": {
      "type": "object",
      "minProperties": 14,
      "additionalProperties": {"enum": [401, 403, 409, 503]},
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]+$"}
    },
    "fencing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentValidationOrder", "sideEffectFreeErrors", "effectsForbiddenBeforeValidation"],
      "properties": {
        "intentValidationOrder": {"$ref": "#/$defs/stringSet"},
        "sideEffectFreeErrors": {"$ref": "#/$defs/stringSet"},
        "effectsForbiddenBeforeValidation": {"$ref": "#/$defs/stringSet"}
      }
    },
    "listeners": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/listener"}
    },
    "strictMutations": {"$ref": "#/$defs/fieldAllowlists"},
    "strictNestedPayloads": {"$ref": "#/$defs/fieldAllowlists"},
    "runtime": {"$ref": "#/$defs/runtime"}
  },
  "$defs": {
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "schemaIdentifiers": {"type": "array", "minItems": 26, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fundingReservationScopeRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "productId", "reservationKind", "nettingScope", "mode"],
      "properties": {
        "accountId": {"type": "string", "minLength": 1},
        "productId": {"const": "funding"},
        "reservationKind": {"const": "open"},
        "nettingScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "venue", "instrumentId", "positionMode", "settlementScope", "venueEnvironment"],
          "properties": {
            "accountId": {"type": "string", "minLength": 1},
            "venue": {"type": "string", "minLength": 1},
            "instrumentId": {"type": "string", "minLength": 1},
            "positionMode": {"type": ["string", "null"]},
            "settlementScope": {"type": ["string", "null"]},
            "venueEnvironment": {"enum": ["demo", "testnet", "live"]}
          }
        },
        "mode": {"enum": ["test", "live"]}
      }
    },
    "fundingReservationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "productId", "reservationKind", "nettingScope", "quantity", "notional", "currency", "mode"],
      "properties": {
        "accountId": {"type": "string", "minLength": 1},
        "productId": {"const": "funding"},
        "reservationKind": {"enum": ["open", "close"]},
        "nettingScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "venue", "instrumentId", "positionMode", "settlementScope", "venueEnvironment"],
          "properties": {
            "accountId": {"type": "string", "minLength": 1},
            "venue": {"type": "string", "minLength": 1},
            "instrumentId": {"type": "string", "minLength": 1},
            "positionMode": {"type": ["string", "null"]},
            "settlementScope": {"type": ["string", "null"]},
            "venueEnvironment": {"enum": ["demo", "testnet", "live"]}
          }
        },
        "quantity": {"type": "string", "minLength": 1},
        "notional": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 1},
        "mode": {"enum": ["test", "live"]}
      }
    },
    "fieldAllowlists": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"}}
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonFieldCase", "decimalEncoding", "timestampEncoding", "modes", "venueEnvironments", "testIncludes", "livePrivateWritesEnabledByDefault", "mutationResponsesRequireRequestId", "streamEventsRequire"],
      "properties": {
        "jsonFieldCase": {"const": "camelCase"},
        "decimalEncoding": {"const": "string"},
        "timestampEncoding": {"const": "RFC3339 UTC"},
        "modes": {"const": ["test", "live"]},
        "venueEnvironments": {"const": ["demo", "testnet", "live"]},
        "testIncludes": {"const": ["demo", "testnet"]},
        "livePrivateWritesEnabledByDefault": {"const": false},
        "mutationResponsesRequireRequestId": {"const": true},
        "streamEventsRequire": {"const": ["eventId", "sequence", "cursor", "observedAt"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browserReceivesGatewayCredential", "browserReceivesSecretValue", "workerReceivesGatewayCredential", "workerReceivesDatabaseCredential", "workerReceivesSecretStoreCredential", "gatewayAcceptsSecretMaterial", "gatewayAcceptsOpaqueSecretReference", "platformOwns", "gatewayOwns", "workerOwns"],
      "properties": {
        "browserReceivesGatewayCredential": {"const": false},
        "browserReceivesSecretValue": {"const": false},
        "workerReceivesGatewayCredential": {"const": false},
        "workerReceivesDatabaseCredential": {"const": false},
        "workerReceivesSecretStoreCredential": {"const": false},
        "gatewayAcceptsSecretMaterial": {"const": false},
        "gatewayAcceptsOpaqueSecretReference": {"const": true},
        "platformOwns": {"$ref": "#/$defs/stringSet"},
        "gatewayOwns": {"$ref": "#/$defs/stringSet"},
        "workerOwns": {"$ref": "#/$defs/stringSet"}
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "address", "namespace", "acceptedPrincipals", "rejectedPrincipals", "routes"],
      "properties": {
        "id": {"enum": ["platform-browser", "platform-funding-work", "gateway-internal"]},
        "address": {"type": "string", "pattern": "^127\\.0\\.0\\.1:[0-9]+$"},
        "namespace": {"type": "string", "pattern": "^/"},
        "acceptedPrincipals": {"$ref": "#/$defs/stringSet"},
        "rejectedPrincipals": {"$ref": "#/$defs/stringSet"},
        "routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processStartOrder", "processStopOrder", "ports", "worker", "modeIsolation", "databases"],
      "properties": {
        "processStartOrder": {"const": ["postgres", "gateway", "platform", "funding-worker", "web"]},
        "processStopOrder": {"const": ["web", "funding-worker", "platform", "gateway", "postgres"]},
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["postgres", "gateway", "platformBrowser", "platformFundingWork", "web"],
          "properties": {
            "postgres": {"const": 15432},
            "gateway": {"const": 18082},
            "platformBrowser": {"const": 18091},
            "platformFundingWork": {"const": 18092},
            "web": {"const": 13001}
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heartbeatIntervalSeconds", "heartbeatTTLSeconds", "leaseDurationSeconds", "maxAttempts", "retryBackoffSeconds", "claimMaxItems", "tokenFiles", "tokenValuesMustDifferAcrossModes", "requiredEnvironment", "forbiddenEnvironment"],
          "properties": {
            "heartbeatIntervalSeconds": {"const": 5},
            "heartbeatTTLSeconds": {"const": 15},
            "leaseDurationSeconds": {"const": 30},
            "maxAttempts": {"const": 5},
            "retryBackoffSeconds": {"const": [1, 2, 4, 8]},
            "claimMaxItems": {"const": 1},
            "tokenFiles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["test", "live"],
              "properties": {
                "test": {"const": "$FT_LOCAL_RUNTIME_DIR/credentials/test/funding-worker.token"},
                "live": {"const": "$FT_LOCAL_RUNTIME_DIR/credentials/live/funding-worker.token"}
              }
            },
            "tokenValuesMustDifferAcrossModes": {"const": true},
            "requiredEnvironment": {"$ref": "#/$defs/stringSet"},
            "forbiddenEnvironment": {"$ref": "#/$defs/stringSet"}
          }
        },
        "modeIsolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crossModeReuseAllowed", "resources"],
          "properties": {
            "crossModeReuseAllowed": {"const": false},
            "resources": {"$ref": "#/$defs/stringSet"}
          }
        },
        "databases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "component", "database", "ownerRole"],
            "properties": {
              "mode": {"enum": ["test", "live"]},
              "component": {"enum": ["platform", "gateway"]},
              "database": {"type": "string", "minLength": 1},
              "ownerRole": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
