# Gateway local runtime configuration. Secret material is supplied by file.
FT_MODE=test
FT_LOCAL_RUNTIME_DIR=/tmp/boltertrader-local
GATEWAY_LISTEN_ADDR=127.0.0.1:18082
GATEWAY_AUTH_TOKEN_FILE=/tmp/boltertrader-local/credentials/test/gateway-adapter.token
GATEWAY_POSTGRES_DSN_FILE=/tmp/boltertrader-local/credentials/test/gateway-postgres.dsn
BT_SECRET_MASTER_KEY_FILE=/tmp/boltertrader-local/credentials/test/secret-store-master.key
BT_SECRET_STORE_NAMESPACE=boltertrader/test
BT_GATEWAY_DATABASE=bolter_gateway_test
BT_GATEWAY_DATABASE_ROLE=bolter_gateway_test
